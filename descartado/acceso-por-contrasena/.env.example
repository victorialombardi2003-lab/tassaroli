# Copy to .env for local development, and set the same two variables in the
# host's dashboard (Netlify: Site configuration > Environment variables).
#
# Never commit the real values.

# The password handed to the people allowed to read the anteproyecto.
# Change it by editing this variable — no code change, no redeploy of content.
ACCESO_PASSWORD="cambiar-esta-clave"

# Signs the access cookie so it cannot be forged. Any long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACCESO_SECRET="cambiar-por-una-cadena-larga-y-aleatoria"

# How long an unlocked session lasts, in hours.
ACCESO_HORAS="12"
