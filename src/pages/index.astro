---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Render from '../components/Render.astro';
import Flecha from '../components/Flecha.astro';
import Escudo from '../components/Escudo.astro';
import Video from '../components/Video.astro';
import Mapa from '../components/Mapa.astro';
// El fondo del hero usa el isotipo del hexágono; la barra superior usa el
// lockup de la Fundación. Son dos marcas distintas y cada una va donde
// corresponde.
import aerea from '../assets/aerea-parque-norte.webp';
import parqueAntecedentes from '../assets/parque-antecedentes.webp';
// La trama urbana de San Rafael, de fondo en la sección que habla del lugar.
import planoSanRafael from '../assets/plano-san-rafael.png';
import {
  sitio,
  video,
  antecedentes,
  porQue,
  activo,
  estado,
  areas,
  arquitectura,
  ubicacion,
  implantacion,
  cierre,
} from '../data/contenido';
---

<Base titulo={`${sitio.fundacion} — ${sitio.proyecto}`} actual="/" heroOscuro>
  {/* ------------------------------------------------------------ portada */}
  {/* Dos láminas en una pista que se corre de a una pantalla: la portada y
      el video. La pista es CSS puro —una transición de `translate`— y el
      script no hace más que cambiar qué número dice `data-activa`. */}
  <section class="portada" data-portada data-activa="0" data-espera={video.espera}>
    <div class="portada__pista">
      <div class="portada__lamina" data-lamina>
        <div class="portada__fondo" data-hero-oscuro>
          <Image
            class="portada__aerea"
            src={aerea}
            alt="Vista aérea del Centro Tecnológico implantado en Parque Norte, San Rafael"
            widths={[900, 1280, 1448]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="portada__velo" aria-hidden="true"></span>
        </div>

        <div class="calle portada__texto">
          <p class="portada__ante">
            <span class="portada__regla"></span>
            <span>Anteproyecto</span>
            <span class="portada__regla"></span>
          </p>

          <Escudo rotulo={['Proyecto', 'Construcción:']} comoTitulo />

          <p class="portada__ubicacion">San Rafael, Mendoza</p>

          <div class="portada__acceso">
            <i class="marca" style="--carril: 0" aria-hidden="true"></i>
            <div class="portada__acciones">
              <a class="accion" href="/proyecto">Conocé nuestro proyecto <Flecha /></a>
              <a class="accion accion--linea" href="/documentacion">Documentación <Flecha /></a>
            </div>
            {video.id && <Video parte="boton" />}
          </div>
        </div>
      </div>

      {
        video.id && (
          <div class="portada__lamina" data-lamina inert>
            <Video parte="lamina" />
          </div>
        )
      }
    </div>

    {video.id && <Video parte="puntos" />}
  </section>

  {/* ------------------------------------------------------- antecedentes */}
  <section class="seccion banda" data-seccion>
    <div class="calle antecedentes">
      <div>
        <Nodo texto="Antecedentes" recorrido="publico" />
        <div class="revela-linea">
          <h2 class="titulo">{antecedentes.titulo}</h2>
          <p class="cuerpo bloque__cuerpo">{antecedentes.cuerpo}</p>
        </div>
      </div>

      <figure class="antecedentes__lamina revela">
        <div class="marco-imagen">
          <Image
            src={parqueAntecedentes}
            alt="El parque del Centro Tecnológico al atardecer, con senderos, canteros y gente caminando"
            widths={[640, 960, 1280, 1537]}
            sizes="(min-width: 62rem) min(46rem, 44vw), 100vw"
            loading="lazy"
          />
        </div>
      </figure>
    </div>
  </section>

  {/* ---------------------------------------------------------- territorio */}
  <section class="seccion territorio" data-seccion>
    <div class="territorio__fondo" aria-hidden="true">
      <Image
        class="territorio__plano"
        src={planoSanRafael}
        alt=""
        widths={[900, 1400, 1821]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
      <span class="territorio__velo"></span>
    </div>

    <div class="calle">
      <Nodo texto="Territorio" recorrido="parque" />
      <div class="revela-linea">
        <h2 class="titulo">{porQue.titulo}</h2>
        <p class="cuerpo bloque__cuerpo">{porQue.cuerpo}</p>

        <ul class="sectores" aria-label="Sectores productivos">
          {porQue.sectores.map((s) => <li class="rotulo sectores__item">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------- activo estratégico */}
  <section class="seccion banda" data-seccion>
    <div class="calle">
      <Nodo texto="Activo estratégico" recorrido="parque" />
      <div class="activo revela-linea">
        <div>
          <h2 class="titulo">{activo.titulo}</h2>
          <p class="cuerpo bloque__cuerpo">{activo.cuerpo}</p>
        </div>

        <dl class="ficha">
          {
            activo.datos.map((d) => (
              <div class="ficha__fila">
                <dt class="ficha__valor cifra" data-contador>{d.valor}</dt>
                <dd class="ficha__detalle">
                  <span class="rotulo ficha__unidad">{d.unidad}</span>
                  <span class="ficha__nota">{d.detalle}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- estado */}
  <section class="seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Estado del proyecto" recorrido="publico" />

      <div class="estado__cab revela">
        <h2 class="titulo">Dónde estamos hoy</h2>
        <p class="estado__desde">Funcionando desde {estado.desde}</p>
      </div>

      {/* Sin `revela-linea`: el revelado genérico de la página escribe
          `opacity` y `transform` en línea sobre los hijos, y acá cada hito lo
          revela la propia línea a medida que le pasa por encima. Dos manos
          sobre las mismas dos propiedades no se pueden repartir el trabajo. */}
      <ol class="hitos">
        {/* Tres piezas superpuestas: el riel tenue que cruza los tres hitos,
            el trazo azul que lo barre con el scroll, y la marca vertical que
            va en la punta del barrido mientras está en movimiento. Las tres
            las mide y posiciona el script, contra los puntos reales. */}
        <span class="hitos__riel" aria-hidden="true"></span>
        <span class="linea-avance" aria-hidden="true"></span>
        <span class="linea-frente" aria-hidden="true"></span>

        {
          estado.hitos.map((h) => (
            <li class="hito" data-fase={h.fase}>
              <i class="hito__punto" aria-hidden="true" />
              <div class="hito__texto">
                <span class="solo-lectores">
                  {h.fase === 'hecho' ? 'Hecho' : h.fase === 'en-curso' ? 'En curso' : 'Previsto'}
                </span>
                <h3 class="subtitulo hito__titulo">{h.titulo}</h3>
                <p class="hito__cuerpo">{h.cuerpo}</p>
                {'enlace' in h && h.enlace && (
                  <a class="hito__enlace" href={h.enlace.href}>
                    {h.enlace.texto} <Flecha />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --------------------------------------------------------------- ubicación */}
  <section class="seccion banda" id="ubicacion" data-seccion>
    <div class="calle">
      <Nodo texto="Ubicación" recorrido="parque" />
      <div class="ubicacion__cab revela-linea">
        <div>
          <h2 class="titulo">{ubicacion.titulo}</h2>
          <p class="rotulo ubicacion__lugar">{ubicacion.lugar}</p>
        </div>
        <p class="cuerpo ubicacion__cuerpo">{ubicacion.cuerpo}</p>
      </div>
    </div>

    <figure class="calle ubicacion__figura revela">
      <Mapa />
      <figcaption class="epigrafe">
        <span class="dato">Fig. 04</span>
        <span>{ubicacion.epigrafe}</span>
      </figcaption>
    </figure>
  </section>

  {/* ----------------------------------------------------------- implantación */}
  <section class="seccion banda-fuerte" data-seccion>
    <div class="calle">
      <Nodo texto="Implantación" recorrido="parque" />
      <div class="revela-linea">
        <h2 class="titulo">{implantacion.titulo}</h2>
        <p class="dato implantacion__lugar">{implantacion.lugar}</p>
      </div>
    </div>
    <figure class="calle implantacion__plano revela">
      <div class="marco-imagen" data-paralaje>
        <Render nombre={implantacion.render} alt={implantacion.alt} ratio="12001 / 5766" sizes="100vw" />
      </div>
      <figcaption class="epigrafe">
        <span class="dato">Fig. 05</span>
        <span>Implantación en el Parque Norte, sobre las nueve hectáreas destinadas por la Fundación.</span>
      </figcaption>
    </figure>
  </section>

  {/* --------------------------------------------------------------- programa */}
  <section class="seccion banda programa" data-seccion>
    <div class="calle">
      <Nodo texto="Programa" recorrido="formacion" />
      <h2 class="titulo revela">Alcances del Centro Tecnológico</h2>
      <p class="cuerpo revela bloque__cuerpo">
        Tres áreas que funcionan juntas: se forma con la industria, se investiga para ella y se
        prototipa con ella.
      </p>
    </div>

    <div class="calle areas">
      {
        areas.map((area, i) => (
          <article class="area revela">
            <figure class="area__lamina">
              <div class="marco-imagen" data-paralaje>
                <Render
                  nombre={area.render}
                  alt={area.alt}
                  ratio="3 / 2"
                  sizes="(min-width: 68rem) 32vw, (min-width: 44rem) 46vw, 100vw"
                />
              </div>
              <figcaption class="epigrafe">
                <span class="dato">Fig. 0{i + 2}</span>
                <span>{area.n}</span>
              </figcaption>
            </figure>
            <h3 class="subtitulo area__titulo">{area.titulo}</h3>
            <p class="cuerpo area__cuerpo">{area.cuerpo}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- arquitectura */}
  <section class="seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Arquitectura" recorrido="investigacion" />
      <h2 class="titulo revela">Criterios del anteproyecto</h2>
    </div>

    <div class="calle criterios">
      {
        arquitectura.map((c, i) => (
          <article class={`criterio ${i % 2 === 1 ? 'criterio--invertido' : ''} revela`}>
            <div class="criterio__imagen">
              <div class="marco-imagen" data-paralaje>
                <Render nombre={c.render} alt={c.alt} ratio="4 / 3" sizes="(min-width: 60rem) 45vw, 100vw" />
              </div>
            </div>
            <div class="criterio__texto">
              <h3 class="subtitulo">{c.titulo}</h3>
              <p class="cuerpo criterio__cuerpo">{c.cuerpo}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------------------- cierre */}
  <section class="seccion cierre" data-seccion>
    <div class="calle">
      <Nodo texto="Documentación" recorrido="publico" />
      <p class="display cierre__lema revela">{cierre.lema}</p>
      <div class="cierre__acciones revela">
        <a class="accion" href="/documentacion">Ver la documentación <Flecha /></a>
        <a class="accion accion--linea" href="/proyecto">Recorrer el proyecto <Flecha /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- portada */
  .portada {
    position: relative;
    overflow: hidden;
    display: grid;
    min-height: 88svh;
  }

  /* Las dos láminas una al lado de la otra, cada una del ancho entero. La
     segunda se sale de la caja por la derecha y el `overflow: hidden` de
     arriba la esconde hasta que le toca. */
  .portada__pista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    align-items: stretch;
    /* `translate` y no `transform`: GSAP anima `transform` en varias cosas
       del hero y no conviene que dos manos escriban la misma propiedad. */
    translate: 0 0;
    transition: translate 900ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .portada[data-activa='1'] .portada__pista {
    translate: -100% 0;
    /* Con el video puesto, la línea del recorrido se va.
       El trazo es un SVG que cruza la página entera por encima de todo
       (z-index 1 dentro de `.pagina`), así que no se puede apagar un tramo
       suyo: lo que se hace es levantar la pista por encima y que lo tape
       donde está la lámina. Fuera del hero el recorrido sigue intacto, que es
       lo que corresponde —la línea es del sitio, no de la portada—, y al
       volver a la primera lámina reaparece sola.

       La pista ya arma contexto de apilado por su `translate`, así que este
       z-index se compara directamente con el del trazo. Queda muy por debajo
       del 50 del encabezado: la barra de navegación nunca se tapa. */
    z-index: 2;
  }

  /* Quien pidió menos movimiento igual llega al video: cambia la lámina,
     nada más que sin el barrido. */
  @media (prefers-reduced-motion: reduce) {
    .portada__pista {
      transition: none;
    }
  }

  .portada__lamina {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    /* Los márgenes se ajustaron cuando entró la firma del Centro debajo de
       las acciones: sin eso el hero pasaba de 1013px en una ventana de 880 y
       el botón de Documentación quedaba abajo del pliegue. */
    padding-block: clamp(5.5rem, 11vh, 8rem) clamp(2rem, 4vw, 3rem);
  }

  /* La lámina del video no lleva márgenes propios: los pone ella adentro,
     donde puede despejar la barra de navegación arriba y alinear el titular
     con la calle a la izquierda. Y se estira en vez de centrarse, porque es
     una grilla de tres filas que necesita el alto entero para repartirlo.

     `nth-child(2)` y no `last-child`: mientras no haya video cargado, la
     segunda lámina no se dibuja y `last-child` le caería encima a la
     portada, cambiándole los márgenes por nada. */
  .portada__lamina:nth-child(2) {
    align-items: stretch;
    padding: 0;
  }

  /* La vista aérea del proyecto, y encima el velo que le devuelve contraste
     al título. La estructura es la misma que antes: un velo horizontal que
     va de opaco a la izquierda, donde vive el texto, a transparente a la
     derecha. Lo único que cambió es el color —era papel, ahora es azul
     noche— y con él el texto, que pasó a blanco.

     Que el velo se corte antes del 62% no es casual: el edificio está en
     ese tercio derecho de la foto. Un velo parejo lo taparía, y entonces
     la aérea sería una textura y no el proyecto. */
  .portada__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--azul-900);
  }

  .portada__aerea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La foto es cálida y verde; el sitio es azul. Un viraje mínimo la
       acerca sin lavarla, y el contraste apenas subido evita que el velo
       la aplaste en un gris. */
    filter: saturate(0.86) contrast(1.06);
    /* Encuadrada abajo, y no al medio, por una razon medible: la mitad
       superior de la aerea tiene los techos blancos del barrio, y ahi el
       texto necesitaba un 85% de velo para ser legible —o sea, tapar la
       foto—. Corrida hacia abajo el texto cae sobre arboleda, y con 46%
       alcanza. El edificio sigue entrando, en el tercio superior. */
    object-position: 50% 85%;
  }

  .portada__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* El velo dejó de ser lateral cuando el texto se centró: antes protegía
         la mitad izquierda y se desvanecía hacia la derecha, que es justo
         donde el texto pasó a estar. Ahora es un óvalo centrado.

         El 62% del centro no es una elección de gusto. Medido sobre el
         percentil 99 de brillo de la franja del texto, el punto más exigente
         está en x=62% —el techo blanco del edificio— y pide 51% para que el
         blanco llegue a 4,5:1. El 62% deja margen; hacia los bordes baja al
         34%, donde no hay texto que proteger y la foto puede respirar. */
      radial-gradient(
        86% 78% at 50% 46%,
        color-mix(in srgb, var(--azul-900) 62%, transparent) 0%,
        color-mix(in srgb, var(--azul-900) 58%, transparent) 46%,
        color-mix(in srgb, var(--azul-900) 44%, transparent) 74%,
        color-mix(in srgb, var(--azul-900) 34%, transparent) 100%
      ),
      /* Un segundo velo vertical, mucho más suave: asienta el título y
         despega las acciones del pasto del pie. */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--azul-900) 30%, transparent) 0%,
        transparent 34%,
        transparent 70%,
        color-mix(in srgb, var(--azul-900) 30%, transparent) 100%
      );
  }

  /* El texto va centrado. La calle deja libre el carril de la izquierda por
     donde baja la línea, así que sin compensar, "centrado" quedaría corrido
     unos 50px a la derecha. El padding de la derecha iguala al de la
     izquierda y el centro vuelve a ser el centro de la ventana. */
  .portada__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline-end: calc(var(--rail) + var(--borde));
    text-align: center;
  }

  .portada__ante {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--azul-400);
  }

  .portada__regla {
    flex: none;
    display: block;
    width: 36px;
    height: 1px;
    background: currentColor;
  }

  /* El escudo trae su propio tamaño; acá sólo se le da el aire de arriba. */
  .portada :global(.escudo) {
    margin-block-start: clamp(1.5rem, 3.4vw, 2.5rem);
  }

  .portada__ubicacion {
    margin-block-start: clamp(1.5rem, 3.2vh, 2.25rem);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .portada__acceso {
    position: relative;
    margin-block-start: clamp(1.75rem, 3.6vh, 2.5rem);
    padding-inline-start: var(--rail);
    margin-inline-start: calc(-1 * var(--rail));
  }

  .portada__acceso .marca {
    inset-block-start: 1.2rem;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  /* El isotipo del Centro debajo de las acciones, solo. El archivo es azul
     y monocromo, y se pasa a blanco con el mismo filtro que usa la apertura
     de Documentación. */
  .portada__centro {
    display: flex;
    margin-block-start: clamp(3rem, 6.5vw, 4.75rem);
  }

  .portada__centro-signo {
    flex: none;
    width: auto;
    height: clamp(3.4rem, 7vw, 4.75rem);
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* En pantallas chicas el signo se corre y baja, y el velo cubre todo el
     ancho: el título nunca compite con la marca de fondo. */
  @media (max-width: 48rem) {
    .portada {
      min-height: 84svh;
    }

    .portada__lamina:first-child {
      padding-block: clamp(4.5rem, 9vh, 6rem) clamp(1.5rem, 3vw, 2.5rem);
    }

    /* En pantalla angosta no hay lugar para que el texto ocupe una mitad y
       el edificio la otra: el velo cubre todo el ancho y la foto queda de
       fondo. Se encuadra a la derecha para no perder el edificio. */
    .portada__aerea {
      object-position: 60% 78%;
    }

    /* El escudo se mantiene en una sola fila también en teléfono, como en la
       pieza del cliente. Lo único que cede es el tamaño: en tres partes y a
       375px de ancho, cada una tiene poco lugar. */
    /* En teléfono el escudo achica: en tres partes y a 375px de ancho, cada
       una tiene poco lugar. */
    .portada {
      --escudo-tam: clamp(1.05rem, 4.9vw, 1.75rem);
    }

    .portada__velo {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--azul-900) 72%, transparent) 0%,
        color-mix(in srgb, var(--azul-900) 62%, transparent) 46%,
        color-mix(in srgb, var(--azul-900) 82%, transparent) 100%
      );
    }

    .portada__ubicacion {
      margin-block-start: 32px;
      font-size: 12px;
      letter-spacing: 0.2em;
    }

    .portada__acceso {
      margin-block-start: 36px;
    }
  }

  /* --------------------------------------------------------------- estado */

  .estado__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .estado__desde {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  /* La tercera columna es más ancha porque lleva el párrafo largo: repartidas
     en tres iguales, ese texto queda el doble de alto que sus vecinos y la
     línea deja de leerse como una línea. */
  .hitos {
    --hueco: 40px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr);
    column-gap: var(--hueco);
    margin-block-start: clamp(2.25rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  /* La posición y la medida se las fija el script, igual que al trazo: los dos
     rieles van del primer punto al último y comparten la misma cuenta. */
  .hitos__riel {
    position: absolute;
    background: #eceef2;
  }

  /* El tramo dibujado. Va absoluto y no como celda de la grilla: su medida no
     sale de las columnas sino de la distancia real entre el primer punto y el
     del hito en curso, que mide el script. `--avance` dice cuánto de esa
     medida está trazado, y el `transition` corto es lo que evita que el trazo
     tiemble con cada muesca de la rueda del mouse. */
  /* El trazo y la marca de su punta. Acá va sólo lo que no cambia: posición,
     medida y eje los fija el script, que es quien puede medir dónde caen los
     puntos de verdad. */
  .linea-avance {
    position: absolute;
    background: var(--azul-600);
    pointer-events: none;
  }

  /* La punta del barrido. Se ve sólo mientras la línea está en movimiento: es
     lo que dice que esto se está dibujando y no que ya estaba dibujado. */
  .linea-frente {
    position: absolute;
    width: 1.5px;
    height: 14px;
    background: var(--azul-600);
    opacity: 0;
    pointer-events: none;
    transition: opacity 120ms linear;
  }

  /* Cada hito lo revela la línea cuando le pasa por encima. La rampa la
     calcula el script en función de cuánto avanzó el frente, así que el
     easing es el scroll: acá sólo va el suavizado corto que evita que el
     texto tiemble entre cuadro y cuadro. */
  .hito__texto {
    opacity: 0;
    transition: opacity 120ms linear, transform 120ms linear;
  }

  /* Los hitos van colocados a mano en su columna. Los dos rieles son hijos de
     la misma grilla y ocupan la fila entera, así que sin esto el emplazamiento
     automático no encuentra celda libre y manda los hitos a columnas
     implícitas detrás del tercero: medido, el primer punto caía en x=261 en vez
     de x=141 y los rieles quedaban de 76px. */
  .hito {
    grid-row: 1;
    position: relative;
    padding-block-start: 32px;
  }

  .hito:nth-of-type(1) {
    grid-column: 1;
  }

  .hito:nth-of-type(2) {
    grid-column: 2;
  }

  .hito:nth-of-type(3) {
    grid-column: 3;
  }

  /* Los puntos nacen en cero y crecen cuando la punta los toca. */
  .hito__punto {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acento);
    transform: scale(0);
    transition: transform 200ms ease-out, background-color 200ms ease-out,
      box-shadow 200ms ease-out;
  }

  .hito.alcanzado .hito__punto {
    transform: scale(1);
  }

  /* El que está en curso es más grande. Arranca hueco como el previsto —la
     línea todavía no llegó— y al ser alcanzado se llena y empieza a latir. */
  .hito[data-fase='en-curso'] .hito__punto {
    inset-block-start: -2px;
    inset-inline-start: -2px;
    width: 12px;
    height: 12px;
    background: var(--papel);
    box-shadow: inset 0 0 0 1.5px #c5cad4;
  }

  .hito[data-fase='en-curso'].alcanzado .hito__punto {
    background: var(--azul-600);
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.16);
    animation: hito-latido 2.4s ease-in-out infinite;
  }

  @keyframes hito-latido {
    0%,
    100% {
      box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.16);
    }
    50% {
      box-shadow: 0 0 0 9px rgba(37, 99, 235, 0.06);
    }
  }

  /* Lo que todavía no pasó queda hueco, incluso después de que la línea le
     pase por encima: el trazo cuenta el recorrido, no que el hito esté hecho. */
  .hito[data-fase='previsto'] .hito__punto {
    background: var(--papel);
    box-shadow: inset 0 0 0 1.5px #c5cad4;
  }

  @media (prefers-reduced-motion: reduce) {
    .linea-avance,
    .linea-frente,
    .hito__texto,
    .hito__punto {
      transition: none;
    }

    .hito[data-fase='en-curso'].alcanzado .hito__punto {
      animation: none;
    }
  }

  .hito__titulo {
    margin: 0;
    line-height: 1.2;
    text-wrap: balance;
  }

  .hito__cuerpo {
    margin-block-start: 0.75rem;
    font-size: 0.96875rem;
    line-height: 1.62;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .hito__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-block-start: 1rem;
    font-family: var(--sans);
    font-stretch: 88%;
    font-weight: 620;
    font-size: 0.75rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .hito__enlace :global(.flecha) {
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hito__enlace:hover :global(.flecha) {
    transform: translateX(4px);
  }

  /* En una columna los hitos se apilan y el barrido se hace hacia abajo. La
     línea sigue siendo la misma pieza: lo que cambia es el eje, y de eso se
     encarga el script. */
  @media (max-width: 62rem) {
    .hitos {
      --sangria: clamp(1.5rem, 5vw, 2.25rem);
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: repeat(3, auto);
      row-gap: clamp(1.75rem, 4vw, 2.5rem);
      padding-inline-start: var(--sangria);
    }

    .hito {
      padding-block-start: 0;
    }

    /* La columna se repite en cada `nth-of-type` y no una vez en `.hito`
       porque las reglas de escritorio son `nth-of-type` también: más
       específicas, le ganarían a una sola declaración suelta y los hitos
       seguirían repartidos en tres columnas. */
    .hito:nth-of-type(1) {
      grid-row: 1;
      grid-column: 1;
    }

    .hito:nth-of-type(2) {
      grid-row: 2;
      grid-column: 1;
    }

    .hito:nth-of-type(3) {
      grid-row: 3;
      grid-column: 1;
    }

    .hito__punto {
      inset-block-start: 0.45rem;
      inset-inline-start: calc(-1 * var(--sangria) - 4.75px);
    }

    .hito[data-fase='en-curso'] .hito__punto {
      inset-block-start: calc(0.45rem - 2px);
      inset-inline-start: calc(-1 * var(--sangria) - 6.75px);
    }
  }

  /* ------------------------------------------------------------ ubicación */

  /* El título a la izquierda y el párrafo al lado, como la cabecera de
     Antecedentes: la sección abre con una afirmación corta y su desarrollo,
     y recién debajo entra el mapa a ancho completo. */
  .ubicacion__cab {
    display: grid;
    gap: clamp(1rem, 3vw, 3.1875rem);
    align-items: end;
  }

  @media (min-width: 62rem) {
    .ubicacion__cab {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .ubicacion__lugar {
    margin-block-start: 0.875rem;
    color: var(--tinta-3);
  }

  .ubicacion__cuerpo {
    margin: 0;
  }

  .ubicacion__figura {
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
  }

  /* --------------------------------------------------------- antecedentes */
  /* El texto a la izquierda y la foto al lado, no debajo ni detrás: la foto
     muestra el parque terminado y el texto cuenta de dónde viene, y se leen
     mejor de a dos que uno tapando al otro. El cuerpo vuelve a una sola
     columna —partido en dos dentro de media pantalla darían renglones de
     veinte caracteres. */
  .antecedentes {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .antecedentes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      max-width: calc(92rem + var(--rail) + 2 * var(--borde));
    }
  }

  .antecedentes__lamina {
    margin: 0;
  }

  /* ---------------------------------------------------------- bloques ---- */
  .sectores {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    padding: 0;
    margin-block-start: clamp(1.75rem, 3.5vw, 2.75rem);
    border-block-start: 1px solid var(--linea-fuerte);
  }

  .sectores__item {
    flex: 1 1 11rem;
    padding: 1.05rem 1.05rem 1.05rem 0;
    color: var(--tinta);
    border-block-end: 1px solid var(--linea);
  }

  .sectores__item + .sectores__item {
    padding-inline-start: 1.05rem;
    border-inline-start: 1px solid var(--linea);
  }

  /* --------------------------------------------------------- territorio */

  /* La sección habla del lugar, así que el lugar está de fondo: la trama
     urbana de San Rafael, apenas por encima del umbral de lo visible. Es
     textura, no ilustración — si se lee como imagen, compite con el texto. */
  .territorio {
    overflow: hidden;
  }

  .territorio__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .territorio__plano {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Dos degradés encimados. El horizontal despeja la izquierda, que es por
     donde baja la línea y donde arranca cada renglón. El vertical corta el
     plano contra las secciones vecinas: sin él, el borde de la imagen se ve
     como un corte recto en el medio de la página. */
  .territorio__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--papel) 78%, transparent) 0%,
        color-mix(in srgb, var(--papel) 40%, transparent) 38%,
        color-mix(in srgb, var(--papel) 12%, transparent) 78%
      ),
      linear-gradient(180deg, var(--papel) 0%, transparent 14%, transparent 86%, var(--papel) 100%);
  }

  /* El texto va por encima del fondo. */
  .territorio > .calle {
    position: relative;
    z-index: 1;
  }

  /* -------------------------------------------------------------- activo */
  .activo {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }

  @media (min-width: 62rem) {
    .activo {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .ficha {
    margin: 0;
    border-block-start: 2px solid var(--tinta);
  }

  .ficha__fila {
    display: flex;
    align-items: baseline;
    gap: clamp(0.9rem, 2.2vw, 1.5rem);
    padding-block: 1.05rem;
    border-block-end: 1px solid var(--linea);
  }

  .ficha__valor {
    margin: 0;
    flex: none;
    min-width: 4.5ch;
    font-size: clamp(1.75rem, 1.35rem + 1.5vw, 2.5rem);
    color: var(--acento);
  }

  .ficha__detalle {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .ficha__unidad {
    color: var(--tinta);
  }

  .ficha__nota {
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--tinta-3);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------- estado */


  /* ------------------------------------------------------------ programa */
  .areas {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.5rem);
    margin-block-start: clamp(2.25rem, 5vw, 3.5rem);
  }

  @media (min-width: 44rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .areas {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .area__titulo {
    margin-block-start: clamp(1rem, 2vw, 1.4rem);
    text-wrap: balance;
  }

  .area__cuerpo {
    margin-block-start: 0.7rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .area__lamina {
    margin: 0;
  }

  /* --------------------------------------------------------- arquitectura */
  .criterios {
    display: flex;
    flex-direction: column;
    gap: clamp(2.75rem, 6vw, 5rem);
    margin-block-start: clamp(2.25rem, 4.5vw, 3.5rem);
  }

  .criterio {
    display: grid;
    gap: clamp(1.35rem, 3vw, 2.5rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .criterio {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .criterio--invertido .criterio__imagen {
      order: 2;
    }
  }

  .criterio__cuerpo {
    margin-block-start: 0.85rem;
    max-width: 46ch;
  }

  /* --------------------------------------------------------- implantación */
  .implantacion__lugar {
    margin-block-start: 0.85rem;
    color: var(--tinta-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .implantacion__plano {
    margin: clamp(2rem, 4.5vw, 3.5rem) auto 0;
  }

  /* -------------------------------------------------------------- cierre */
  .cierre {
    background: var(--azul-50);
    border-block-start: 1px solid var(--linea);
  }

  .cierre__lema {
    max-width: 15ch;
    color: var(--tinta);
    margin-block-start: 0.25rem;
  }

  .cierre__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: clamp(1.75rem, 4vw, 2.75rem);
  }
</style>

<script>
  /**
   * La línea de tiempo del estado: el trazo barre y va revelando cada hito.
   *
   * Antes del scroll sólo se ve el riel tenue. El trazo azul barre de
   * izquierda a derecha —hacia abajo si los hitos están apilados— y cada hito
   * aparece cuando la punta le pasa por encima: el punto crece y el texto sube
   * desde catorce píxeles más abajo, a lo largo de una rampa de noventa
   * píxeles de recorrido del frente. El easing es el scroll; las transiciones
   * cortas del CSS sólo evitan que el texto tiemble entre cuadro y cuadro.
   *
   * Es reversible: al subir, la línea retrocede y los hitos se apagan en el
   * orden inverso.
   *
   * El frente corre noventa píxeles más allá del último punto a propósito: sin
   * esa cola, el texto del tercer hito se quedaría a mitad de aparecer cuando
   * el trazo ya llegó al final.
   */
  const ol = document.querySelector<HTMLElement>('.hitos');
  const riel = ol?.querySelector<HTMLElement>('.hitos__riel');
  const trazo = ol?.querySelector<HTMLElement>('.linea-avance');
  const marca = ol?.querySelector<HTMLElement>('.linea-frente');
  const hitos = ol ? Array.from(ol.querySelectorAll<HTMLElement>('.hito')) : [];
  const puntos = hitos.map((h) => h.querySelector<HTMLElement>('.hito__punto'));
  const textos = hitos.map((h) => h.querySelector<HTMLElement>('.hito__texto'));

  if (ol && riel && trazo && marca && hitos.length > 1 && puntos.every(Boolean) && textos.every(Boolean)) {
    const quieto = matchMedia('(prefers-reduced-motion: reduce)');
    const angosto = matchMedia('(max-width: 62rem)');

    /* Cuánto recorrido del frente tarda un hito en aparecer del todo, y entre
       qué alturas de la ventana ocurre todo el barrido. */
    const RAMPA = 90;
    const INICIO = 0.9;
    const FIN = 0.3;

    const acotar = (v: number) => Math.min(1, Math.max(0, v));

    /* Los centros de los puntos, en coordenadas del `ol` y en los dos ejes.
       Hacen falta los dos: el barrido usa uno como eje de avance y el otro
       para colocar el trazo a lo ancho. Guardar sólo el del avance —como si
       en vertical alcanzara la `y`— deja el trazo apilado sobre el margen. */
    let pos: { x: number; y: number }[] = [];

    function medir() {
      const caja = ol!.getBoundingClientRect();
      pos = puntos.map((pt) => {
        const r = pt!.getBoundingClientRect();
        return {
          x: r.left + r.width / 2 - caja.left,
          y: r.top + r.height / 2 - caja.top,
        };
      });
      pintar();
    }

    function pintar() {
      const vertical = angosto.matches;
      // Quien pidió menos movimiento recibe todo puesto desde el primer cuadro.
      const p = quieto.matches
        ? 1
        : acotar(
            (innerHeight * INICIO - ol!.getBoundingClientRect().top) /
              (innerHeight * (INICIO - FIN)),
          );

      /* El eje de avance y el transversal. El transversal se toma del primer
         punto: los tres están alineados sobre el riel. */
      const avance = (i: number) => (vertical ? pos[i].y : pos[i].x);
      const cruce = vertical ? pos[0].x : pos[0].y;
      const desde = avance(0);
      const hasta = avance(pos.length - 1);

      const frente = desde + p * (hasta - desde + RAMPA);
      const largo = Math.max(0, Math.min(frente, hasta) - desde);

      const caja = vertical
        ? `left:${cruce - 0.75}px; top:${desde}px; width:1.5px; height:`
        : `left:${desde}px; top:${cruce - 0.75}px; height:1.5px; width:`;

      riel!.style.cssText = `${caja}${hasta - desde}px;`;
      trazo!.style.cssText = `${caja}${largo}px;`;

      /* La marca de la punta, sólo mientras el trazo está en movimiento. Se
         escribe de una sola vez y no con `+=`: `cssText` se lee y se reasigna
         entero, así que sumarle declaraciones en cada cuadro hace crecer la
         cadena para siempre. */
      const punta = Math.min(frente, hasta);
      const visible = p > 0 && frente < hasta ? 1 : 0;
      marca!.style.cssText = vertical
        ? `top:${punta - 0.75}px; left:${cruce - 7}px; width:14px; height:1.5px; opacity:${visible};`
        : `left:${punta - 0.75}px; top:${cruce - 7}px; width:1.5px; height:14px; opacity:${visible};`;

      pos.forEach((_, i) => {
        // Los seis píxeles de adelanto hacen que el hito empiece a aparecer
        // cuando la punta lo está tocando, no después de pasarlo.
        const r = acotar((frente - avance(i) + 6) / RAMPA);
        textos[i]!.style.opacity = String(r);
        textos[i]!.style.transform = `translateY(${Math.round((1 - r) * 14)}px)`;
        hitos[i].classList.toggle('alcanzado', i === 0 ? p > 0 : r > 0);
      });
    }

    medir();
    addEventListener('scroll', pintar, { passive: true });
    addEventListener('resize', medir);
    addEventListener('load', medir, { once: true });
    // Las fuentes cambian el alto de los títulos, y con él la distancia entre
    // hitos cuando están apilados.
    document.fonts?.ready.then(medir);
    // Y cualquier otra cosa que mueva la caja: la pantalla de carga puede
    // dejar el layout a medio asentar cuando corre la primera medición.
    new ResizeObserver(medir).observe(ol);
    angosto.addEventListener('change', medir);
  }
</script>
