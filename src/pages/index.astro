---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Render from '../components/Render.astro';
import Flecha from '../components/Flecha.astro';
import Escudo from '../components/Escudo.astro';
import Video from '../components/Video.astro';
import Mapa from '../components/Mapa.astro';
// El fondo del hero usa el isotipo del hexágono; la barra superior usa el
// lockup de la Fundación. Son dos marcas distintas y cada una va donde
// corresponde.
import aerea from '../assets/aerea-parque-norte.webp';
import parqueAntecedentes from '../assets/parque-antecedentes.webp';
// La trama urbana de San Rafael, de fondo en la sección que habla del lugar.
import planoSanRafael from '../assets/plano-san-rafael.png';
import {
  sitio,
  video,
  antecedentes,
  porQue,
  activo,
  estado,
  areas,
  arquitectura,
  ubicacion,
  implantacion,
  cierre,
} from '../data/contenido';
---

<Base titulo={`${sitio.fundacion} — ${sitio.proyecto}`} actual="/" heroOscuro>
  {/* ------------------------------------------------------------ portada */}
  {/* Dos láminas en una pista que se corre de a una pantalla: la portada y
      el video. La pista es CSS puro —una transición de `translate`— y el
      script no hace más que cambiar qué número dice `data-activa`. */}
  <section class="portada" data-portada data-activa="0" data-espera={video.espera}>
    <div class="portada__pista">
      <div class="portada__lamina" data-lamina>
        <div class="portada__fondo" data-hero-oscuro>
          <Image
            class="portada__aerea"
            src={aerea}
            alt="Vista aérea del Centro Tecnológico implantado en Parque Norte, San Rafael"
            widths={[900, 1280, 1448]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
          <span class="portada__velo" aria-hidden="true"></span>
        </div>

        <div class="calle portada__texto">
          <p class="portada__ante">
            <span class="portada__regla"></span>
            <span>Anteproyecto</span>
            <span class="portada__regla"></span>
          </p>

          <Escudo rotulo={['Proyecto', 'Construcción:']} comoTitulo />

          <p class="portada__ubicacion">San Rafael, Mendoza</p>

          <div class="portada__acceso">
            <i class="marca" style="--carril: 0" aria-hidden="true"></i>
            <div class="portada__acciones">
              <a class="accion" href="/proyecto">Conocé nuestro proyecto <Flecha /></a>
              <a class="accion accion--linea" href="/documentacion">Documentación <Flecha /></a>
            </div>
            {video.id && <Video parte="boton" />}
          </div>
        </div>
      </div>

      {
        video.id && (
          <div class="portada__lamina" data-lamina inert>
            <Video parte="lamina" />
          </div>
        )
      }
    </div>

    {video.id && <Video parte="puntos" />}
  </section>

  {/* ------------------------------------------------------- antecedentes */}
  <section class="seccion banda" data-seccion>
    <div class="calle antecedentes">
      <div>
        <Nodo texto="Antecedentes" recorrido="publico" />
        <div class="revela-linea">
          <h2 class="titulo">{antecedentes.titulo}</h2>
          <p class="cuerpo bloque__cuerpo">{antecedentes.cuerpo}</p>
        </div>
      </div>

      <figure class="antecedentes__lamina revela">
        <div class="marco-imagen">
          <Image
            src={parqueAntecedentes}
            alt="El parque del Centro Tecnológico al atardecer, con senderos, canteros y gente caminando"
            widths={[640, 960, 1280, 1537]}
            sizes="(min-width: 62rem) min(46rem, 44vw), 100vw"
            loading="lazy"
          />
        </div>
      </figure>
    </div>
  </section>

  {/* ---------------------------------------------------------- territorio */}
  <section class="seccion territorio" data-seccion>
    <div class="territorio__fondo" aria-hidden="true">
      <Image
        class="territorio__plano"
        src={planoSanRafael}
        alt=""
        widths={[900, 1400, 1821]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
      />
      <span class="territorio__velo"></span>
    </div>

    <div class="calle">
      <Nodo texto="Territorio" recorrido="parque" />
      <div class="revela-linea">
        <h2 class="titulo">{porQue.titulo}</h2>
        <p class="cuerpo bloque__cuerpo">{porQue.cuerpo}</p>

        <ul class="sectores" aria-label="Sectores productivos">
          {porQue.sectores.map((s) => <li class="rotulo sectores__item">{s}</li>)}
        </ul>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------- activo estratégico */}
  <section class="seccion banda" data-seccion>
    <div class="calle">
      <Nodo texto="Activo estratégico" recorrido="parque" />
      <div class="activo revela-linea">
        <div>
          <h2 class="titulo">{activo.titulo}</h2>
          <p class="cuerpo bloque__cuerpo">{activo.cuerpo}</p>
        </div>

        <dl class="ficha">
          {
            activo.datos.map((d) => (
              <div class="ficha__fila">
                <dt class="ficha__valor cifra" data-contador>{d.valor}</dt>
                <dd class="ficha__detalle">
                  <span class="rotulo ficha__unidad">{d.unidad}</span>
                  <span class="ficha__nota">{d.detalle}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- estado */}
  <section class="seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Estado del proyecto" recorrido="publico" />

      <div class="estado__cab revela">
        <h2 class="titulo">Dónde estamos hoy</h2>
        <p class="estado__desde">Funcionando desde {estado.desde}</p>
      </div>

      <ol class="hitos revela-linea">
        {/* Dos rieles superpuestos: el gris cruza los tres hitos y el azul
            llega hasta el que está en curso. El azul no lleva un porcentaje
            calculado a mano —se desacomodaría con cualquier cambio de
            columnas—: ocupa la primera columna y se estira sobre el hueco
            siguiente con un margen negativo, así que termina exactamente
            sobre el segundo punto mida lo que mida la ventana. */}
        <span class="hitos__riel" aria-hidden="true"></span>
        <span class="hitos__riel hitos__riel__andado" aria-hidden="true"></span>

        {
          estado.hitos.map((h) => (
            <li class="hito" data-fase={h.fase}>
              <i class="hito__punto" aria-hidden="true" />
              <span class="solo-lectores">
                {h.fase === 'hecho' ? 'Hecho' : h.fase === 'en-curso' ? 'En curso' : 'Previsto'}
              </span>
              <h3 class="subtitulo hito__titulo">{h.titulo}</h3>
              <p class="hito__cuerpo">{h.cuerpo}</p>
              {'enlace' in h && h.enlace && (
                <a class="hito__enlace" href={h.enlace.href}>
                  {h.enlace.texto} <Flecha />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* --------------------------------------------------------------- ubicación */}
  <section class="seccion banda" id="ubicacion" data-seccion>
    <div class="calle">
      <Nodo texto="Ubicación" recorrido="parque" />
      <div class="ubicacion__cab revela-linea">
        <div>
          <h2 class="titulo">{ubicacion.titulo}</h2>
          <p class="rotulo ubicacion__lugar">{ubicacion.lugar}</p>
        </div>
        <p class="cuerpo ubicacion__cuerpo">{ubicacion.cuerpo}</p>
      </div>
    </div>

    <figure class="calle ubicacion__figura revela">
      <Mapa />
      <figcaption class="epigrafe">
        <span class="dato">Fig. 04</span>
        <span>{ubicacion.epigrafe}</span>
      </figcaption>
    </figure>
  </section>

  {/* ----------------------------------------------------------- implantación */}
  <section class="seccion banda-fuerte" data-seccion>
    <div class="calle">
      <Nodo texto="Implantación" recorrido="parque" />
      <div class="revela-linea">
        <h2 class="titulo">{implantacion.titulo}</h2>
        <p class="dato implantacion__lugar">{implantacion.lugar}</p>
      </div>
    </div>
    <figure class="calle implantacion__plano revela">
      <div class="marco-imagen" data-paralaje>
        <Render nombre={implantacion.render} alt={implantacion.alt} ratio="12001 / 5766" sizes="100vw" />
      </div>
      <figcaption class="epigrafe">
        <span class="dato">Fig. 05</span>
        <span>Implantación en el Parque Norte, sobre las nueve hectáreas destinadas por la Fundación.</span>
      </figcaption>
    </figure>
  </section>

  {/* --------------------------------------------------------------- programa */}
  <section class="seccion banda programa" data-seccion>
    <div class="calle">
      <Nodo texto="Programa" recorrido="formacion" />
      <h2 class="titulo revela">Alcances del Centro Tecnológico</h2>
      <p class="cuerpo revela bloque__cuerpo">
        Tres áreas que funcionan juntas: se forma con la industria, se investiga para ella y se
        prototipa con ella.
      </p>
    </div>

    <div class="calle areas">
      {
        areas.map((area, i) => (
          <article class="area revela">
            <figure class="area__lamina">
              <div class="marco-imagen" data-paralaje>
                <Render
                  nombre={area.render}
                  alt={area.alt}
                  ratio="3 / 2"
                  sizes="(min-width: 68rem) 32vw, (min-width: 44rem) 46vw, 100vw"
                />
              </div>
              <figcaption class="epigrafe">
                <span class="dato">Fig. 0{i + 2}</span>
                <span>{area.n}</span>
              </figcaption>
            </figure>
            <h3 class="subtitulo area__titulo">{area.titulo}</h3>
            <p class="cuerpo area__cuerpo">{area.cuerpo}</p>
          </article>
        ))
      }
    </div>
  </section>

  {/* ----------------------------------------------------------- arquitectura */}
  <section class="seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Arquitectura" recorrido="investigacion" />
      <h2 class="titulo revela">Criterios del anteproyecto</h2>
    </div>

    <div class="calle criterios">
      {
        arquitectura.map((c, i) => (
          <article class={`criterio ${i % 2 === 1 ? 'criterio--invertido' : ''} revela`}>
            <div class="criterio__imagen">
              <div class="marco-imagen" data-paralaje>
                <Render nombre={c.render} alt={c.alt} ratio="4 / 3" sizes="(min-width: 60rem) 45vw, 100vw" />
              </div>
            </div>
            <div class="criterio__texto">
              <h3 class="subtitulo">{c.titulo}</h3>
              <p class="cuerpo criterio__cuerpo">{c.cuerpo}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* ---------------------------------------------------------------- cierre */}
  <section class="seccion cierre" data-seccion>
    <div class="calle">
      <Nodo texto="Documentación" recorrido="publico" />
      <p class="display cierre__lema revela">{cierre.lema}</p>
      <div class="cierre__acciones revela">
        <a class="accion" href="/documentacion">Ver la documentación <Flecha /></a>
        <a class="accion accion--linea" href="/proyecto">Recorrer el proyecto <Flecha /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------- portada */
  .portada {
    position: relative;
    overflow: hidden;
    display: grid;
    min-height: 88svh;
  }

  /* Las dos láminas una al lado de la otra, cada una del ancho entero. La
     segunda se sale de la caja por la derecha y el `overflow: hidden` de
     arriba la esconde hasta que le toca. */
  .portada__pista {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    align-items: stretch;
    /* `translate` y no `transform`: GSAP anima `transform` en varias cosas
       del hero y no conviene que dos manos escriban la misma propiedad. */
    translate: 0 0;
    transition: translate 900ms cubic-bezier(0.76, 0, 0.24, 1);
  }

  .portada[data-activa='1'] .portada__pista {
    translate: -100% 0;
    /* Con el video puesto, la línea del recorrido se va.
       El trazo es un SVG que cruza la página entera por encima de todo
       (z-index 1 dentro de `.pagina`), así que no se puede apagar un tramo
       suyo: lo que se hace es levantar la pista por encima y que lo tape
       donde está la lámina. Fuera del hero el recorrido sigue intacto, que es
       lo que corresponde —la línea es del sitio, no de la portada—, y al
       volver a la primera lámina reaparece sola.

       La pista ya arma contexto de apilado por su `translate`, así que este
       z-index se compara directamente con el del trazo. Queda muy por debajo
       del 50 del encabezado: la barra de navegación nunca se tapa. */
    z-index: 2;
  }

  /* Quien pidió menos movimiento igual llega al video: cambia la lámina,
     nada más que sin el barrido. */
  @media (prefers-reduced-motion: reduce) {
    .portada__pista {
      transition: none;
    }
  }

  .portada__lamina {
    position: relative;
    display: flex;
    align-items: center;
    min-width: 0;
    /* Los márgenes se ajustaron cuando entró la firma del Centro debajo de
       las acciones: sin eso el hero pasaba de 1013px en una ventana de 880 y
       el botón de Documentación quedaba abajo del pliegue. */
    padding-block: clamp(5.5rem, 11vh, 8rem) clamp(2rem, 4vw, 3rem);
  }

  /* La lámina del video no lleva márgenes propios: los pone ella adentro,
     donde puede despejar la barra de navegación arriba y alinear el titular
     con la calle a la izquierda. Y se estira en vez de centrarse, porque es
     una grilla de tres filas que necesita el alto entero para repartirlo.

     `nth-child(2)` y no `last-child`: mientras no haya video cargado, la
     segunda lámina no se dibuja y `last-child` le caería encima a la
     portada, cambiándole los márgenes por nada. */
  .portada__lamina:nth-child(2) {
    align-items: stretch;
    padding: 0;
  }

  /* La vista aérea del proyecto, y encima el velo que le devuelve contraste
     al título. La estructura es la misma que antes: un velo horizontal que
     va de opaco a la izquierda, donde vive el texto, a transparente a la
     derecha. Lo único que cambió es el color —era papel, ahora es azul
     noche— y con él el texto, que pasó a blanco.

     Que el velo se corte antes del 62% no es casual: el edificio está en
     ese tercio derecho de la foto. Un velo parejo lo taparía, y entonces
     la aérea sería una textura y no el proyecto. */
  .portada__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--azul-900);
  }

  .portada__aerea {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* La foto es cálida y verde; el sitio es azul. Un viraje mínimo la
       acerca sin lavarla, y el contraste apenas subido evita que el velo
       la aplaste en un gris. */
    filter: saturate(0.86) contrast(1.06);
    /* Encuadrada abajo, y no al medio, por una razon medible: la mitad
       superior de la aerea tiene los techos blancos del barrio, y ahi el
       texto necesitaba un 85% de velo para ser legible —o sea, tapar la
       foto—. Corrida hacia abajo el texto cae sobre arboleda, y con 46%
       alcanza. El edificio sigue entrando, en el tercio superior. */
    object-position: 50% 85%;
  }

  .portada__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      /* El velo dejó de ser lateral cuando el texto se centró: antes protegía
         la mitad izquierda y se desvanecía hacia la derecha, que es justo
         donde el texto pasó a estar. Ahora es un óvalo centrado.

         El 62% del centro no es una elección de gusto. Medido sobre el
         percentil 99 de brillo de la franja del texto, el punto más exigente
         está en x=62% —el techo blanco del edificio— y pide 51% para que el
         blanco llegue a 4,5:1. El 62% deja margen; hacia los bordes baja al
         34%, donde no hay texto que proteger y la foto puede respirar. */
      radial-gradient(
        86% 78% at 50% 46%,
        color-mix(in srgb, var(--azul-900) 62%, transparent) 0%,
        color-mix(in srgb, var(--azul-900) 58%, transparent) 46%,
        color-mix(in srgb, var(--azul-900) 44%, transparent) 74%,
        color-mix(in srgb, var(--azul-900) 34%, transparent) 100%
      ),
      /* Un segundo velo vertical, mucho más suave: asienta el título y
         despega las acciones del pasto del pie. */
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--azul-900) 30%, transparent) 0%,
        transparent 34%,
        transparent 70%,
        color-mix(in srgb, var(--azul-900) 30%, transparent) 100%
      );
  }

  /* El texto va centrado. La calle deja libre el carril de la izquierda por
     donde baja la línea, así que sin compensar, "centrado" quedaría corrido
     unos 50px a la derecha. El padding de la derecha iguala al de la
     izquierda y el centro vuelve a ser el centro de la ventana. */
  .portada__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-inline-end: calc(var(--rail) + var(--borde));
    text-align: center;
  }

  .portada__ante {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--azul-400);
  }

  .portada__regla {
    flex: none;
    display: block;
    width: 36px;
    height: 1px;
    background: currentColor;
  }

  /* El escudo trae su propio tamaño; acá sólo se le da el aire de arriba. */
  .portada :global(.escudo) {
    margin-block-start: clamp(1.5rem, 3.4vw, 2.5rem);
  }

  .portada__ubicacion {
    margin-block-start: clamp(1.5rem, 3.2vh, 2.25rem);
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .portada__acceso {
    position: relative;
    margin-block-start: clamp(1.75rem, 3.6vh, 2.5rem);
    padding-inline-start: var(--rail);
    margin-inline-start: calc(-1 * var(--rail));
  }

  .portada__acceso .marca {
    inset-block-start: 1.2rem;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  /* El isotipo del Centro debajo de las acciones, solo. El archivo es azul
     y monocromo, y se pasa a blanco con el mismo filtro que usa la apertura
     de Documentación. */
  .portada__centro {
    display: flex;
    margin-block-start: clamp(3rem, 6.5vw, 4.75rem);
  }

  .portada__centro-signo {
    flex: none;
    width: auto;
    height: clamp(3.4rem, 7vw, 4.75rem);
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  /* En pantallas chicas el signo se corre y baja, y el velo cubre todo el
     ancho: el título nunca compite con la marca de fondo. */
  @media (max-width: 48rem) {
    .portada {
      min-height: 84svh;
    }

    .portada__lamina:first-child {
      padding-block: clamp(4.5rem, 9vh, 6rem) clamp(1.5rem, 3vw, 2.5rem);
    }

    /* En pantalla angosta no hay lugar para que el texto ocupe una mitad y
       el edificio la otra: el velo cubre todo el ancho y la foto queda de
       fondo. Se encuadra a la derecha para no perder el edificio. */
    .portada__aerea {
      object-position: 60% 78%;
    }

    /* El escudo se mantiene en una sola fila también en teléfono, como en la
       pieza del cliente. Lo único que cede es el tamaño: en tres partes y a
       375px de ancho, cada una tiene poco lugar. */
    /* En teléfono el escudo achica: en tres partes y a 375px de ancho, cada
       una tiene poco lugar. */
    .portada {
      --escudo-tam: clamp(1.05rem, 4.9vw, 1.75rem);
    }

    .portada__velo {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--azul-900) 72%, transparent) 0%,
        color-mix(in srgb, var(--azul-900) 62%, transparent) 46%,
        color-mix(in srgb, var(--azul-900) 82%, transparent) 100%
      );
    }

    .portada__ubicacion {
      margin-block-start: 32px;
      font-size: 12px;
      letter-spacing: 0.2em;
    }

    .portada__acceso {
      margin-block-start: 36px;
    }
  }

  /* --------------------------------------------------------------- estado */

  .estado__cab {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .estado__desde {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  /* La tercera columna es más ancha porque lleva el párrafo largo: repartidas
     en tres iguales, ese texto queda el doble de alto que sus vecinos y la
     línea deja de leerse como una línea. */
  .hitos {
    --hueco: 40px;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.6fr);
    column-gap: var(--hueco);
    margin-block-start: clamp(2.25rem, 5vw, 3.5rem);
    padding: 0;
    list-style: none;
  }

  .hitos__riel {
    grid-row: 1;
    grid-column: 1 / -1;
    align-self: start;
    height: 1.5px;
    margin-block-start: 3px;
    margin-inline-start: 4px;
    background: var(--linea);
  }

  /* El tramo andado llega hasta el segundo punto: ocupa la primera columna,
     cruza el hueco con un margen negativo y suma los cuatro píxeles del radio
     del punto, que es donde está su centro. Sin esos cuatro, el azul moría en
     el borde del punto en vez de en el punto —medido, 461 contra 465. */
  .hitos__riel__andado {
    grid-column: 1 / 2;
    margin-inline-end: calc(-1 * var(--hueco) - 4px);
    background: var(--acento);
