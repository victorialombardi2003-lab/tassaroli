---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Render from '../components/Render.astro';
import Carrusel from '../components/Carrusel.astro';
import Flecha from '../components/Flecha.astro';
import placaCarta from '../assets/placa-carta.webp';
import { sitio, carta, espacios, proposito } from '../data/contenido';

/**
 * El ritmo del recorrido: los espacios grandes ocupan el ancho completo,
 * los chicos van pareados con su texto. La escala de la lámina responde al
 * tamaño real del espacio, no a una decisión gráfica arbitraria.
 */
type Recorrido = 'publico' | 'parque' | 'formacion' | 'investigacion';

/**
 * Cada espacio se lee con el texto a la izquierda y la imagen a la derecha.
 * Antes los espacios grandes iban a sangre con el texto debajo; leerlo así
 * obliga a bajar la vista para saber qué se está mirando.
 *
 * Y hay un efecto de calidad: en esta disposición la imagen ocupa unos 650px
 * y no los 928 del carrusel a sangre. Como los renders del estudio miden
 * 1537px de ancho, a 650 no se agrandan ni siquiera en una pantalla retina,
 * que pide el doble. Es el único lugar del sitio donde eso se cumple.
 *
 * Lo único que varía por espacio es a qué recorrido pertenece, que es lo que
 * hace cambiar de carril a la línea.
 */
const recorridos: Record<string, Recorrido> = {
  'Espacios comunes': 'publico',
  'Sala de reuniones': 'publico',
  'Salas de encuentro': 'publico',
  Auditorio: 'publico',
  Circulaciones: 'parque',
  Laboratorios: 'investigacion',
  Aulas: 'formacion',
  'HUB IDI': 'investigacion',
  Coworking: 'formacion',
  'Baño y vestuarios': 'publico',
  Taller: 'formacion',
  Exteriores: 'parque',
};

/**
 * Casi todos los renders del estudio vienen en 3:2, y el marco los toma tal
 * cual. Los de exteriores llegaron en 4:3 —y alguno más alto todavía—: con
 * un marco de 3:2 el recorte se les come el 11% del alto, que en una vista
 * de parque es justo el cielo y las copas de los arboles. Cada espacio
 * declara entonces su proporcion cuando no es la de siempre.
 */
const proporciones: Record<string, string> = {
  Exteriores: '4 / 3',
};

const lista = espacios.map((e, i) => ({
  ...e,
  recorrido: recorridos[e.nodo] ?? 'publico',
  ratio: proporciones[e.nodo] ?? '3 / 2',
  fig: String(i + 1).padStart(2, '0'),
}));
---

<Base
  titulo={`Proyecto Construcción — ${sitio.fundacion}`}
  descripcion="El anteproyecto del Centro Tecnológico Carlos José Tassaroli, espacio por espacio."
  actual="/proyecto"
  heroOscuro={true}
>
  {/* ------------------------------------------------------------ apertura */}
  <section class="apertura sangrado" data-hero-oscuro>
    <div class="apertura__fondo">
      <Render
        nombre="hero-proyecto"
        alt="Vista general del Centro Tecnológico Carlos José Tassaroli"
        ratio="16 / 9"
        prioridad={true}
        sizes="100vw"
        clase="apertura__render"
      />
      <span class="apertura__velo apertura__velo--vertical"></span>
      <span class="apertura__velo apertura__velo--horizontal"></span>
    </div>

    <div class="calle apertura__texto">
      <p class="apertura__ante">
        <span class="apertura__regla"></span>
        <span>Anteproyecto · Estudio Lucchesi</span>
      </p>

      <h1 class="display apertura__titulo">
        Proyecto Construcción
        <span class="apertura__nombre">Centro Tecnológico Carlos José Tassaroli</span>
      </h1>

      <div class="apertura__pie">
        <a class="apertura__bajar" href="#recorrido">
          <span>Bajar al recorrido</span>
          <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
            <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- carta */}
  <section class="seccion banda carta-seccion" id="recorrido" data-seccion>
    <div class="calle">
      <Nodo texto="Carta de la presidenta" recorrido="publico" />
      <blockquote class="carta__epigrafe revela">
        <p>{carta.epigrafe}</p>
      </blockquote>
      <div class="carta revela-linea">
        {carta.parrafos.map((p) => <p class="cuerpo">{p}</p>)}
      </div>

      <div class="firma revela">
        <p class="firma__nombre">{carta.firma}</p>
        <p class="rotulo firma__cargo">{carta.cargo}</p>
      </div>
    </div>

    <div class="calle solapa">
      <figure class="solapa__placa revela">
        <Image
          src={placaCarta}
          alt="Desarrolla e impulsa: Fundación Tassaroli. Patrocinan y acompañan: Gobierno de Mendoza y Municipalidad de San Rafael."
          widths={[640, 960, 1280, 1488]}
          sizes="(min-width: 58rem) 52rem, 92vw"
          loading="lazy"
        />
      </figure>
    </div>
  </section>

  {/* ------------------------------------------------------------ espacios */}
  <section class="seccion espacios" data-seccion>
    <div class="calle">
      <Nodo texto="El recorrido" recorrido="parque" />
      <h2 class="titulo revela">Espacio por espacio</h2>
      <p class="cuerpo revela espacios__bajada">
        Doce ambientes definidos en el anteproyecto, en el orden en que se recorren.
      </p>
    </div>

    {
      lista.map((e) => (
        <article class="espacio" data-seccion>
          <div class="calle espacio__par">
            <div class="espacio__texto">
              <Nodo texto={e.nodo} recorrido={e.recorrido} />
              <div class="revela-linea">
                <h3 class="subtitulo">{e.titulo}</h3>
                <p class="cuerpo espacio__cuerpo">{e.cuerpo}</p>
              </div>
            </div>

            {e.renders.length > 1 ? (
              <div class="espacio__carrusel revela">
                <Carrusel
                  renders={e.renders}
                  alt={e.alt}
                  titulo={e.titulo}
                  fig={e.fig}
                  ratio={e.ratio}
                  ancho="par"
                />
              </div>
            ) : (
              <figure class="espacio__lamina revela">
                <div class="marco-imagen" data-paralaje>
                  <Render
                    nombre={e.renders[0]}
                    alt={e.alt}
                    ratio={e.ratio}
                    sizes="(min-width: 62rem) min(46rem, 44vw), 100vw"
                  />
                </div>
                <figcaption class="epigrafe">
                  <span class="dato">Fig. {e.fig}</span>
                  <span>{e.titulo}</span>
                </figcaption>
              </figure>
            )}
          </div>
        </article>
      ))
    }
  </section>

  {/* ------------------------------------------------------------ propósito */}
  <section class="seccion proposito" data-seccion>
    <div class="calle">
      <Nodo texto="Propósito" recorrido="publico" />
      <blockquote class="proposito__cita revela">
        <p>{proposito.cita}</p>
        <cite class="rotulo proposito__fuente">Fundación Tassaroli</cite>
      </blockquote>

      <div class="proposito__texto revela-linea">
        <h2 class="titulo">{proposito.titulo}</h2>
        <p class="cuerpo bloque__cuerpo">{proposito.cuerpo}</p>
      </div>

      <div class="proposito__accion revela">
        <a class="accion" href="/documentacion">Ver la documentación <Flecha /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ apertura */
  .apertura {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .apertura__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .apertura__fondo :global(.apertura__render),
  .apertura__fondo :global(.lamina) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
  }

  .apertura__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apertura__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* El render entregado es claro (luminancia media 153/255), así que la
     rampa inferior sube antes y más fuerte que en la especificación: con los
     valores originales el antetítulo quedaba en 3.4:1, por debajo del mínimo
     AA. Con esta rampa llega a 5.4:1. */
  .apertura__velo--vertical {
    background: linear-gradient(
      180deg,
      rgba(20, 33, 61, 0.72) 0%,
      rgba(20, 33, 61, 0.3) 32%,
      rgba(20, 33, 61, 0.26) 52%,
      rgba(20, 33, 61, 0.6) 70%,
      rgba(20, 33, 61, 0.82) 86%,
      rgba(20, 33, 61, 0.92) 100%
    );
  }

  .apertura__velo--horizontal {
    background: linear-gradient(
      90deg,
      rgba(20, 33, 61, 0.62) 0%,
      rgba(20, 33, 61, 0.12) 48%,
      transparent 72%
    );
  }

  .apertura__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block-end: 3.5rem;
  }

  .apertura__ante {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Un escalón más claro que el #9dc0ff de la especificación, para que a
       11px llegue a 5.4:1 sobre el render. */
    color: #b8d4ff;
  }

  .apertura__regla {
    flex: none;
    display: block;
    width: 36px;
    height: 1px;
    background: var(--azul-400);
  }

  .apertura__titulo {
    margin-block-start: clamp(1rem, 2.2vw, 1.5rem);
    max-width: 18ch;
    line-height: 0.99;
    color: #ffffff;
  }

  .apertura__nombre {
    display: block;
    margin-block-start: 0.16em;
    font-size: 0.58em;
    font-weight: 600;
    font-stretch: 96%;
    line-height: 1.06;
    letter-spacing: -0.026em;
    color: #f2f5fb;
  }

  .apertura__pie {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 52px;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid rgba(255, 255, 255, 0.18);
  }

  .apertura__bajar {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 180ms ease-out;
  }

  .apertura__bajar svg {
    rotate: 90deg;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apertura__bajar:hover {
    color: #ffffff;
  }

  .apertura__bajar:hover svg {
    transform: translateX(4px);
  }

  .apertura :global(:focus-visible) {
    outline-color: var(--azul-400);
  }

  @media (max-width: 48rem) {
    .apertura__texto {
      padding-block-end: 2.5rem;
    }

    .apertura__pie {
      margin-block-start: 34px;
    }

    .apertura__velo--horizontal {
      background: linear-gradient(90deg, rgba(20, 33, 61, 0.6) 0%, rgba(20, 33, 61, 0.25) 100%);
    }
  }

  /* --------------------------------------------------------------- carta */
  /* La cita abre la carta y tiene que leerse como una frase, no como una
     columna angosta apilada en seis renglones contra el margen izquierdo con
     media página vacía al lado.
     La medida va en `rem` y no en `ch` a propósito: `ch` se resuelve con el
     tamaño de fuente del elemento donde se declara —el del cuerpo, no el de
     la cita, que es el doble—, así que daba una caja mucho más angosta de lo
     que parecía. */
  .carta__epigrafe {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: min(60rem, 100%);
    border-inline-start: 2px solid var(--acento);
    padding-inline-start: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .carta__epigrafe p {
    font-size: clamp(1.25rem, 1rem + 1.9vw, 2.375rem);
    font-weight: 520;
    line-height: 1.25;
    letter-spacing: -0.024em;
    color: var(--tinta);
    text-wrap: pretty;
  }

  .carta {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
    max-width: var(--medida);
  }

  .carta .cuerpo:first-child {
    font-size: clamp(1.125rem, 1.05rem + 0.55vw, 1.3125rem);
    color: var(--tinta);
  }

  /* La carta es el texto más largo del sitio. En una sola columna la mancha
     queda tan alta que se lee como un trámite; en dos entra de un vistazo.
     Sólo donde hay ancho real: más angosto, cada columna baja de los 40
     caracteres y el renglón se corta a cada rato. */
  @media (min-width: 60rem) {
    .carta {
      display: block;
      max-width: min(100%, 106ch);
      columns: 2;
      column-gap: clamp(2.25rem, 4vw, 4.5rem);
    }

    /* Un párrafo partido al medio por el salto de columna obliga a subir la
       vista para seguir leyendo. Enteros, se reparten tres y tres. Además el
       `gap` del flex ya no aplica, así que la separación vuelve al margen. */
    .carta > .cuerpo {
      break-inside: avoid;
      margin-block-end: 1.3rem;
    }

    /* La firma cierra la carta, no una de las dos columnas. */
    .firma {
      column-span: all;
    }
  }

  /* La solapa institucional cierra la carta.

     Va entera y contenida, no a sangre. La lámina del cliente es una
     contratapa de presentación: el logo de la Fundación está arriba a la
     izquierda y los patrocinadores abajo a la derecha, y entre las dos
     puntas hay un 93% del alto. A sangre habría que recortarla, y cualquier
     recorte pierde una de las dos. Contenida entra completa, que es lo que
     esa lámina tiene para decir.

     El tope de 52rem no es sólo de composición: el archivo mide 1488px de
     ancho, así que a 832px no se agranda ni en una pantalla retina, que
     pide el doble. */
  .solapa {
    margin-block-start: clamp(2.5rem, 6vw, 4.5rem);
  }

  .solapa__placa {
    max-width: min(100%, 52rem);
    margin: 0 auto;
  }

  .solapa__placa :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 3px;
  }

  /* La firma va sobre el papel y no sobre el azul. Quien lee la carta llega
     al nombre de quien la escribe antes de entrar en la placa institucional,
     que es de la Fundacion y no de ella. */
  .firma {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    padding-block-start: 1.35rem;
    border-block-start: 1px solid var(--linea-fuerte);
  }

  .firma__nombre {
    font-stretch: 102%;
    font-weight: 640;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }

  .firma__cargo {
    margin-block-start: 0.35rem;
    color: var(--tinta-3);
  }

  .solapa :global(.marca) {
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.28);
  }

  /* ------------------------------------------------------------ espacios */
  .espacios__bajada {
    margin-block-start: 0.85rem;
  }

  .espacio {
    padding-block-start: clamp(3rem, 7vw, 5.5rem);
  }

  .espacio__lamina {
    margin: 0;
  }

  .espacio__texto {
    padding-block-start: clamp(1.35rem, 3vw, 2rem);
  }

  .espacio__cuerpo {
    margin-block-start: 0.85rem;
  }

  .espacio__par {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .espacio__par {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      /* Tope de ancho, y no es una decisión estética.
         La imagen mide (contenido - hueco) / 2.05 * 1.05. Con el contenido
         topado en 92rem eso da 729px, y una pantalla retina pide el doble:
         1458px. Los renders del estudio miden 1537. O sea que acá, a
         cualquier tamaño de ventana, la imagen se achica o queda igual;
         nunca se agranda. Sin el tope, un monitor de 2560 pediría 2310px de
         una imagen de 1537 y se vería blanda. */
      max-width: calc(92rem + var(--rail) + 2 * var(--borde));
    }
  }

  /* ----------------------------------------------------------- propósito */
  .proposito {
    background: var(--azul-50);
    border-block-start: 1px solid var(--linea);
    margin-block-start: clamp(4rem, 9vw, 7rem);
  }

  /* En rem y no en ch: la unidad ch se mide contra el tamaño de letra del
     elemento donde se declara, y acá ese elemento es el blockquote, que
     hereda los 17px del cuerpo. Las "24ch" daban 204px y partían la frase
     en seis renglones de dos palabras. La frase entra en dos líneas, que es
     como se lee una afirmación de este tipo. */
  .proposito__cita {
    margin: 0 0 clamp(2rem, 4.5vw, 3.25rem);
    max-width: min(100%, 50rem);
  }

  .proposito__cita p {
    font-size: clamp(1.625rem, 1.1rem + 2.3vw, 3rem);
    font-weight: 650;
    font-stretch: 102%;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--acento-fuerte);
    text-wrap: balance;
  }

  .proposito__fuente {
    display: block;
    margin-block-start: 0.9rem;
    font-style: normal;
    color: var(--tinta-3);
  }

  .proposito__accion {
    margin-block-start: clamp(1.75rem, 3.5vw, 2.5rem);
  }
</style>
