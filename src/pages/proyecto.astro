---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Render from '../components/Render.astro';
import Cabecera from '../components/Cabecera.astro';
import Galeria from '../components/Galeria.astro';
import Flecha from '../components/Flecha.astro';
import Escudo from '../components/Escudo.astro';
import mapa from '../assets/mapa-mendoza.webp';
import { sitio, espacios, proposito, demanda } from '../data/contenido';

/**
 * El ritmo del recorrido: los espacios grandes ocupan el ancho completo,
 * los chicos van pareados con su texto. La escala de la lámina responde al
 * tamaño real del espacio, no a una decisión gráfica arbitraria.
 */
type Recorrido = 'publico' | 'parque' | 'formacion' | 'investigacion';

/**
 * Cada espacio se lee con el texto a la izquierda y la imagen a la derecha.
 * Antes los espacios grandes iban a sangre con el texto debajo; leerlo así
 * obliga a bajar la vista para saber qué se está mirando.
 *
 * Y hay un efecto de calidad: en esta disposición la imagen ocupa unos 650px
 * y no los 928 del carrusel a sangre. Como los renders del estudio miden
 * 1537px de ancho, a 650 no se agrandan ni siquiera en una pantalla retina,
 * que pide el doble. Es el único lugar del sitio donde eso se cumple.
 *
 * Lo único que varía por espacio es a qué recorrido pertenece, que es lo que
 * hace cambiar de carril a la línea.
 */
const recorridos: Record<string, Recorrido> = {
  'Espacios comunes': 'publico',
  'Sala de reuniones': 'publico',
  'Salas de encuentro': 'publico',
  Auditorio: 'publico',
  Circulaciones: 'parque',
  Laboratorios: 'investigacion',
  Aulas: 'formacion',
  'HUB IDI': 'investigacion',
  Coworking: 'formacion',
  'Baño y vestuarios': 'publico',
  Taller: 'formacion',
  Exteriores: 'parque',
};

/**
 * Casi todos los renders del estudio vienen en 3:2, y el marco los toma tal
 * cual. Los de exteriores llegaron en 4:3 —y alguno más alto todavía—: con
 * un marco de 3:2 el recorte se les come el 11% del alto, que en una vista
 * de parque es justo el cielo y las copas de los arboles. Cada espacio
 * declara entonces su proporcion cuando no es la de siempre.
 */
const proporciones: Record<string, string> = {
  Exteriores: '4 / 3',
};

const lista = espacios.map((e, i) => ({
  ...e,
  recorrido: recorridos[e.nodo] ?? 'publico',
  ratio: proporciones[e.nodo] ?? '3 / 2',
  fig: String(i + 1).padStart(2, '0'),
}));
---

<Base
  titulo={`Proyecto Construcción — ${sitio.fundacion}`}
  descripcion="El anteproyecto del Centro Tecnológico Carlos José Tassaroli, espacio por espacio."
  actual="/proyecto"
  heroOscuro={true}
>
  {/* ------------------------------------------------------------ apertura */}
  <section class="apertura sangrado" data-hero-oscuro>
    <div class="apertura__fondo">
      <Render
        nombre="hero-proyecto"
        alt="Vista general del Centro Tecnológico Carlos José Tassaroli"
        ratio="16 / 9"
        prioridad={true}
        sizes="100vw"
        clase="apertura__render"
      />
      <span class="apertura__velo apertura__velo--vertical"></span>
      <span class="apertura__velo apertura__velo--horizontal"></span>
    </div>

    <div class="calle apertura__texto">
      <p class="apertura__ante">
        <span class="apertura__regla"></span>
        <span>Anteproyecto · Estudio Lucchesi</span>
      </p>

      <p class="apertura__previo">Proyecto Construcción</p>

      {/* El escudo va sin el rótulo de la izquierda: acá "Proyecto
          Construcción" es un renglón propio, arriba, y repetirlo al costado
          del signo sería decirlo dos veces. */}
      <Escudo comoTitulo />

      <div class="apertura__pie">
        <a class="apertura__bajar" href="#recorrido">
          <span>Bajar al recorrido</span>
          <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
            <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ propósito */}
  {/* Abre la página: antes de recorrer los doce espacios, para qué existen.
      Estaba al final y el cliente la pidió adelante. */}
  <section class="seccion proposito" data-seccion>
    <div class="calle">
      <Nodo texto="Propósito" recorrido="publico" />

      <div class="proposito__arriba">
        <div class="proposito__columna">
          <blockquote class="proposito__cita revela">
            <p>
              <span class="proposito__liviano">{proposito.cita.liviano}</span>{' '}
              <span class="proposito__fuerte">{proposito.cita.fuerte}</span>
            </p>
            <cite class="rotulo proposito__fuente">Fundación Tassaroli</cite>
          </blockquote>

          <div class="proposito__texto revela-linea">
            <h2 class="titulo">{proposito.titulo}</h2>
            <p class="cuerpo bloque__cuerpo">{proposito.cuerpo}</p>
          </div>
        </div>

        {/* El texto alternativo no es decorativo: los dos rótulos están
            dibujados dentro del mapa, así que quien no lo ve no tiene de
            dónde sacarlos. */}
        <figure class="proposito__mapa revela">
          <Image
            src={mapa}
            alt="Mapa de Mendoza: los proyectos mineros en el norte de la provincia y la Formación Vaca Muerta en el sur."
            width={458}
            height={858}
            densities={[1, 2]}
            loading="lazy"
          />
        </figure>

        {/* Las cifras van apiladas al costado del mapa, como en la pieza del
            cliente, y de paso el alto del mapa deja de ser espacio vacío.
            Los números se cuentan desde cero al entrar en pantalla: el
            mecanismo es el mismo `data-contador` de las fichas del inicio. */}
        <div class="demanda revela-linea">
          {
            demanda.sectores.map((s) => (
              <div class="demanda__bloque">
                <p class="demanda__rotulo">
                  {s.nombre},<br />
                  {s.bajada}
                </p>
                <p class="demanda__concepto">{s.concepto}</p>
                {/* Flex y no una línea sola de texto: entre dos elementos de
                    un contenedor flex el espacio en blanco del código no
                    cuenta, así que la barra queda pegada a los números sin
                    tener que escribir todo apretado en un renglón. */}
                <p class="demanda__cifra">
                  <span class="demanda__n" data-contador>{s.directo}</span>
                  <span class="demanda__barra">/</span>
                  <span class="demanda__n" data-contador>{s.indirecto}</span>
                </p>
              </div>
            ))
          }

            <div class="demanda__bloque">
              <p class="demanda__rotulo">{demanda.rotulo}</p>
              <ul class="demanda__oficios">
                {demanda.oficios.map((o) => <li>{o}</li>)}
              </ul>
            </div>
        </div>
      </div>

      <div class="proposito__accion revela">
        <a class="accion" href="/documentacion">Ver la documentación <Flecha /></a>
      </div>
    </div>
  </section>

  {/* ------------------------------------------------------------ espacios */}
  <section class="seccion espacios" id="recorrido" data-seccion>
    <div class="calle">
      <Nodo texto="El recorrido" recorrido="parque" />
      <h2 class="titulo revela">Espacio por espacio</h2>
      <p class="cuerpo revela espacios__bajada">
        Doce ambientes definidos en el anteproyecto, en el orden en que se recorren.
      </p>
    </div>

    {
      lista.map((e) => {
        const filmado = 'clip' in e && e.clip;
        /* Con recorrido filmado la cabecera es el video y la galería se queda
           con todas las vistas. Sin él, la cabecera toma la primera vista y la
           galería sigue desde la segunda: si no, la misma imagen aparecería
           dos veces seguidas, recortada arriba y entera abajo. */
        const vistas = filmado ? e.renders : e.renders.slice(1);
        return (
          <article class="espacio" data-seccion>
            <Nodo texto={e.nodo} recorrido={e.recorrido} />

            <div class="revela">
              <Cabecera
                espacio={e.titulo}
                clip={filmado ? e.clip : undefined}
                render={filmado ? undefined : e.renders[0]}
                alt={e.alt}
              />
            </div>

            <div class="calle espacio__par">
              <p class="cuerpo espacio__cuerpo revela-linea">{e.cuerpo}</p>

              {vistas.length > 0 && (
                <div class="revela">
                  <Galeria
                    renders={vistas}
                    alt={e.alt}
                    titulo={e.titulo}
                    fig={e.fig}
                    ratio={e.ratio}
                    inicio={filmado ? 1 : 2}
                  />
                </div>
              )}
            </div>
          </article>
        );
      })
    }
  </section>

</Base>

<style>
  /* ------------------------------------------------------------ apertura */
  .apertura {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .apertura__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .apertura__fondo :global(.apertura__render),
  .apertura__fondo :global(.lamina) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
  }

  .apertura__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apertura__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* El render entregado es claro (luminancia media 153/255), así que la
     rampa inferior sube antes y más fuerte que en la especificación: con los
     valores originales el antetítulo quedaba en 3.4:1, por debajo del mínimo
     AA. Con esta rampa llega a 5.4:1. */
  .apertura__velo--vertical {
    background: linear-gradient(
      180deg,
      rgba(20, 33, 61, 0.72) 0%,
      rgba(20, 33, 61, 0.3) 32%,
      rgba(20, 33, 61, 0.26) 52%,
      rgba(20, 33, 61, 0.6) 70%,
      rgba(20, 33, 61, 0.82) 86%,
      rgba(20, 33, 61, 0.92) 100%
    );
  }

  .apertura__velo--horizontal {
    background: linear-gradient(
      90deg,
      rgba(20, 33, 61, 0.62) 0%,
      rgba(20, 33, 61, 0.12) 48%,
      transparent 72%
    );
  }

  .apertura__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block-end: 3.5rem;
  }

  .apertura__ante {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Un escalón más claro que el #9dc0ff de la especificación, para que a
       11px llegue a 5.4:1 sobre el render. */
    color: #b8d4ff;
  }

  .apertura__regla {
    flex: none;
    display: block;
    width: 36px;
    height: 1px;
    background: var(--azul-400);
  }

  /* "Proyecto Construcción" arriba, como renglón propio. En Montserrat para
     que forme una sola voz con el escudo que va debajo, y no en la tipografía
     del resto del sitio. */
  .apertura__previo {
    margin-block-start: clamp(0.9rem, 2vw, 1.35rem);
    font-family: 'Montserrat', var(--sans);
    font-size: clamp(1.1rem, 0.75rem + 1.5vw, 2rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: rgba(255, 255, 255, 0.88);
  }

  /* El mismo escudo que abre el inicio, para que las dos aperturas digan lo
     mismo de la misma manera. Acá va al ras de la izquierda y no centrado:
     esta apertura apoya su texto abajo a la izquierda sobre el render, y
     centrarlo lo dejaría flotando en el medio de la foto. */
  .apertura__texto :global(.escudo) {
    justify-content: flex-start;
    margin-block-start: clamp(0.6rem, 1.4vw, 1rem);
  }

  .apertura__pie {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 52px;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid rgba(255, 255, 255, 0.18);
  }

  .apertura__bajar {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 180ms ease-out;
  }

  .apertura__bajar svg {
    rotate: 90deg;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apertura__bajar:hover {
    color: #ffffff;
  }

  .apertura__bajar:hover svg {
    transform: translateX(4px);
  }

  .apertura :global(:focus-visible) {
    outline-color: var(--azul-400);
  }

  @media (max-width: 48rem) {
    .apertura__texto {
      padding-block-end: 2.5rem;
    }

    .apertura__pie {
      margin-block-start: 34px;
    }

    .apertura__velo--horizontal {
      background: linear-gradient(90deg, rgba(20, 33, 61, 0.6) 0%, rgba(20, 33, 61, 0.25) 100%);
    }
  }

  /* ------------------------------------------------------------ espacios */
  .espacios__bajada {
    margin-block-start: 0.85rem;
  }

  /* El nodo se cuelga del artículo y no de la calle, que es lo que lo deja en
     el carril a la altura de la cabecera. `.nodo` se posiciona contra el
     ancestro posicionado más cercano, así que el artículo tiene que serlo. */
  .espacio {
    position: relative;
    padding-block-start: clamp(3rem, 7vw, 5.5rem);
  }

  .espacio__cuerpo {
    margin-block-start: 0;
  }

  /* Debajo de la cabecera el texto ya no compite con un título: empieza
     arriba de todo, alineado con la primera miniatura. */
  .espacio__par {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: start;
    padding-block-start: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* Sin esto la pista de miniaturas estira su columna y se lleva la fila
     entera: un hijo de grilla mide por defecto `min-width: auto`, o sea lo
     que pida su contenido, y diecinueve miniaturas piden 1888px. Medido en
     una ventana de 375, la galería y el párrafo se salían del borde. */
  .espacio__par > * {
    min-width: 0;
  }

  @media (min-width: 62rem) {
    .espacio__par {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      /* Tope de ancho, y no es una decisión estética.
         La imagen mide (contenido - hueco) / 2.05 * 1.05. Con el contenido
         topado en 92rem eso da 729px, y una pantalla retina pide el doble:
         1458px. Los renders del estudio miden 1537. O sea que acá, a
         cualquier tamaño de ventana, la imagen se achica o queda igual;
         nunca se agranda. Sin el tope, un monitor de 2560 pediría 2310px de
         una imagen de 1537 y se vería blanda. */
      max-width: calc(92rem + var(--rail) + 2 * var(--borde));
    }
  }

  /* ----------------------------------------------------------- propósito */
  /* Ahora abre la página, así que el filete va abajo: arriba tiene la
     apertura oscura, que ya separa sola. */
  .proposito {
    background: var(--azul-50);
    border-block-end: 1px solid var(--linea);
  }

  /* La frase va en Montserrat y no en Archivo, que es la del resto del
     sitio, porque es la tipografía de la pieza del cliente y esto es una
     cita de esa pieza. Ya viene cargada para el escudo, así que no cuesta
     una descarga más.

     En rem y no en ch: la unidad ch se mide contra el tamaño de letra del
     elemento donde se declara, y acá ese elemento es el blockquote, que
     hereda los 17px del cuerpo. Las "24ch" daban 204px y partían la frase
     en seis renglones de dos palabras. */
  .proposito__cita {
    margin: 0 0 clamp(2rem, 4.5vw, 3.25rem);
    max-width: min(100%, 52rem);
  }

  .proposito__cita p {
    font-family: 'Montserrat', var(--sans);
    font-size: clamp(1.75rem, 1.05rem + 2.1vw, 2.75rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* El dato en gris y liviano, el plazo en azul y sólido, como en la pieza.
     El gris es --tinta-3, el más claro del sitio que sigue siendo legible:
     4,9:1 sobre el papel, y acá encima es texto grande. */
  .proposito__liviano {
    font-weight: 300;
    color: var(--tinta-3);
  }

  .proposito__fuerte {
    font-weight: 700;
    color: var(--acento);
  }

  .proposito__fuente {
    display: block;
    margin-block-start: 0.9rem;
    font-style: normal;
    color: var(--tinta-3);
  }

  /* El par de arriba: el argumento a la izquierda, el mapa a la derecha.
     El corte va en 60rem y no en las 52rem del resto de la página porque el
     mapa no se puede angostar sin volverse ilegible: antes de ese ancho, las
     dos columnas no entran y conviene apilarlas. */
  .proposito__arriba {
    display: grid;
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }

  /* Paso intermedio: el argumento ocupa el ancho entero y abajo van el mapa
     y las cifras, que es el par que se lee junto. Tres columnas no entran
     todavía; apilar las tres sería tirar el alto del mapa a la basura. */
  @media (min-width: 46rem) {
    .proposito__arriba {
      grid-template-columns: min(38%, 19rem) minmax(0, 1fr);
    }

    .proposito__columna {
      grid-column: 1 / -1;
    }
  }

  /* Y con ancho de sobra, las tres en fila. El mapa mide 1716px de alto
     contra 916 de ancho, así que es lo más alto de la sección: poner las
     cifras a su lado, en vez de debajo, es lo que la acorta a la mitad.

     La columna del mapa lleva medida propia y no `auto`. Con `auto` la
     columna se mide por su contenido y el contenido —una imagen al 100%— se
     mide por la columna: la cuenta se muerde la cola y el navegador la
     resuelve en cero. La imagen desaparecía sin dejar rastro ni error. */
  @media (min-width: 72rem) {
    .proposito__arriba {
      grid-template-columns: minmax(0, 1.05fr) min(25%, 19rem) minmax(0, 0.82fr);
    }

    .proposito__columna {
      grid-column: auto;
    }
  }

  /* El mapa trae los rótulos dibujados adentro, así que el ancho al que se
     muestre decide si se leen o no. Medido sobre el original: un renglón de
     rótulo ocupa 37px de los 916 de ancho, o sea que por debajo de unos
     340px el texto cae de 14px y deja de leerse. De ahí el piso de 23rem, y
     de ahí que el mapa quede alto —son 1716px contra 916— y que la columna
     de texto se centre a su lado en vez de alinearse arriba. */
  .proposito__mapa {
    margin: 0;
  }

  .proposito__mapa :global(img) {
    display: block;
    inline-size: 100%;
    /* El tope vale para cuando las columnas se apilan: ahí la figura ocupa
       todo el ancho y sin esto el mapa se iría a 900px de alto. */
    max-inline-size: 19rem;
    block-size: auto;
    margin-inline: auto;
  }

  /* ------------------------------------------------------------ demanda */
  /* Una debajo de la otra, como en la pieza del cliente, y separadas por un
     filete: filetes y no tarjetas, que es como separa la pieza. */
  .demanda {
    display: grid;
    align-content: start;
    gap: clamp(1.1rem, 2.4vw, 1.5rem);
  }

  .demanda__bloque + .demanda__bloque {
    padding-block-start: clamp(1.1rem, 2.4vw, 1.5rem);
    border-block-start: 1px solid var(--linea);
  }

  .demanda__rotulo {
    font-family: 'Montserrat', var(--sans);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tinta-3);
  }

  /* La flecha y el más van como contenido generado: son signos de la pieza,
     no palabras, y así no se copian junto con el texto ni hay que colgarles
     un aria-hidden a cada uno. */
  .demanda__concepto {
    margin-block-start: clamp(0.9rem, 2vw, 1.25rem);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--tinta-2);
  }

  .demanda__concepto::before {
    content: '→';
    margin-inline-end: 0.45em;
    color: var(--acento);
  }

  .demanda__cifra {
    display: flex;
    align-items: baseline;
    margin-block-start: 0.4rem;
    font-family: 'Montserrat', var(--sans);
    font-size: clamp(1.625rem, 1.15rem + 1.5vw, 2.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--acento);
  }

  /* `inline-block` no es cosmético: mientras cuenta, el contador le fija el
     ancho que el número va a ocupar al terminar, para que la fila no se
     sacuda cuando pasa de un dígito a cinco. Y `min-width` no se le aplica
     a un elemento en línea. */
  .demanda__n {
    display: inline-block;
  }

  /* La barra en liviano: separa sin competir con las cifras. */
  .demanda__barra {
    font-weight: 300;
  }

  .demanda__oficios {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin-block-start: clamp(0.9rem, 2vw, 1.25rem);
  }

  .demanda__oficios li {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--tinta-2);
  }

  .demanda__oficios li::before {
    content: '+';
    margin-inline-end: 0.5em;
    font-weight: 620;
    color: var(--acento);
  }

  .proposito__accion {
    margin-block-start: clamp(1.75rem, 3.5vw, 2.5rem);
  }
</style>
