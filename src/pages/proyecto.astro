---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Render from '../components/Render.astro';
import Carrusel from '../components/Carrusel.astro';
import Flecha from '../components/Flecha.astro';
import Escudo from '../components/Escudo.astro';
import placa from '../assets/placa-fondo.webp';
import logoFundacion from '../assets/logos/fundacion.png';
import { sitio, carta, espacios, proposito } from '../data/contenido';

/**
 * El ritmo del recorrido: los espacios grandes ocupan el ancho completo,
 * los chicos van pareados con su texto. La escala de la lámina responde al
 * tamaño real del espacio, no a una decisión gráfica arbitraria.
 */
type Recorrido = 'publico' | 'parque' | 'formacion' | 'investigacion';

/**
 * Cada espacio se lee con el texto a la izquierda y la imagen a la derecha.
 * Antes los espacios grandes iban a sangre con el texto debajo; leerlo así
 * obliga a bajar la vista para saber qué se está mirando.
 *
 * Y hay un efecto de calidad: en esta disposición la imagen ocupa unos 650px
 * y no los 928 del carrusel a sangre. Como los renders del estudio miden
 * 1537px de ancho, a 650 no se agrandan ni siquiera en una pantalla retina,
 * que pide el doble. Es el único lugar del sitio donde eso se cumple.
 *
 * Lo único que varía por espacio es a qué recorrido pertenece, que es lo que
 * hace cambiar de carril a la línea.
 */
const recorridos: Record<string, Recorrido> = {
  'Espacios comunes': 'publico',
  'Sala de reuniones': 'publico',
  'Salas de encuentro': 'publico',
  Auditorio: 'publico',
  Circulaciones: 'parque',
  Laboratorios: 'investigacion',
  Aulas: 'formacion',
  'HUB IDI': 'investigacion',
  Coworking: 'formacion',
  'Baño y vestuarios': 'publico',
  Taller: 'formacion',
  Exteriores: 'parque',
};

/**
 * Casi todos los renders del estudio vienen en 3:2, y el marco los toma tal
 * cual. Los de exteriores llegaron en 4:3 —y alguno más alto todavía—: con
 * un marco de 3:2 el recorte se les come el 11% del alto, que en una vista
 * de parque es justo el cielo y las copas de los arboles. Cada espacio
 * declara entonces su proporcion cuando no es la de siempre.
 */
const proporciones: Record<string, string> = {
  Exteriores: '4 / 3',
};

const lista = espacios.map((e, i) => ({
  ...e,
  recorrido: recorridos[e.nodo] ?? 'publico',
  ratio: proporciones[e.nodo] ?? '3 / 2',
  fig: String(i + 1).padStart(2, '0'),
}));
---

<Base
  titulo={`Proyecto Construcción — ${sitio.fundacion}`}
  descripcion="El anteproyecto del Centro Tecnológico Carlos José Tassaroli, espacio por espacio."
  actual="/proyecto"
  heroOscuro={true}
>
  {/* ------------------------------------------------------------ apertura */}
  <section class="apertura sangrado" data-hero-oscuro>
    <div class="apertura__fondo">
      <Render
        nombre="hero-proyecto"
        alt="Vista general del Centro Tecnológico Carlos José Tassaroli"
        ratio="16 / 9"
        prioridad={true}
        sizes="100vw"
        clase="apertura__render"
      />
      <span class="apertura__velo apertura__velo--vertical"></span>
      <span class="apertura__velo apertura__velo--horizontal"></span>
    </div>

    <div class="calle apertura__texto">
      <p class="apertura__ante">
        <span class="apertura__regla"></span>
        <span>Anteproyecto · Estudio Lucchesi</span>
      </p>

      <p class="apertura__previo">Proyecto Construcción</p>

      {/* El escudo va sin el rótulo de la izquierda: acá "Proyecto
          Construcción" es un renglón propio, arriba, y repetirlo al costado
          del signo sería decirlo dos veces. */}
      <Escudo comoTitulo />

      <div class="apertura__pie">
        <a class="apertura__bajar" href="#recorrido">
          <span>Bajar al recorrido</span>
          <svg width="15" height="10" viewBox="0 0 15 10" fill="none" aria-hidden="true">
            <path d="M0 5h13M9 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- carta */}
  {/* En la página queda la tapa; la carta entera se lee en una ventana. El
      texto es el mismo, sólo cambió dónde se lee: en la página era la mancha
      más alta del sitio y el cliente pidió acortarla. */}
  <section class="seccion banda carta-seccion" id="recorrido" data-seccion>
    <div class="calle">
      <Nodo texto="Carta de la presidenta" recorrido="publico" />

      <div class="carta-tapa revela-linea">
        <div>
          <p class="dato carta-tapa__num">{carta.numero}</p>
          <h2 class="titulo carta-tapa__titulo">{carta.titulo}</h2>
          <p class="rotulo carta-tapa__marca">{sitio.fundacion}</p>
        </div>

        <div class="carta-tapa__accion">
          <button class="accion" type="button" data-carta-abre>
            {carta.abrir} <Flecha />
          </button>
          <span class="dato carta-tapa__lectura">{carta.lectura}</span>
        </div>
      </div>
    </div>

    {/* Un <dialog> nativo: la tecla Escape, el foco atrapado adentro y el
        resto de la página inerte los resuelve el navegador sin una línea
        nuestra. */}
    <dialog class="carta-ventana" data-carta-ventana aria-label={`${carta.titulo}, ${sitio.fundacion}`}>
      <article class="carta-panel">
        <header class="carta-panel__cab">
          <span class="carta-panel__id">
            <span class="dato carta-panel__num">{carta.numero}</span>
            <span class="rotulo carta-panel__rotulo">{carta.titulo} · {sitio.fundacion}</span>
          </span>

          <form method="dialog">
            <button class="carta-panel__cerrar" type="submit">
              <span>Cerrar</span>
              <span aria-hidden="true">×</span>
            </button>
          </form>
        </header>

        <div class="carta-panel__cuerpo">
          <blockquote class="carta__epigrafe">
            <p>{carta.epigrafe}</p>
          </blockquote>

          <div class="carta">
            {carta.parrafos.map((p) => <p class="cuerpo">{p}</p>)}
          </div>

          <div class="firma">
            <p class="firma__nombre">{carta.firma}</p>
            <p class="rotulo firma__cargo">{carta.cargo}</p>
          </div>

          {/* La placa institucional cierra la carta. Sale del margen del
              cuerpo para ocupar el ancho entero del panel, como en la pieza
              del cliente. */}
          <div class="placa" style={`--placa: url(${placa.src})`}>
            <div class="placa__impulsa">
              <p class="placa__rotulo placa__rotulo--claro">Desarrolla e impulsa</p>
              <span class="placa__tarjeta">
                <Image src={logoFundacion} alt="Fundación Tassaroli" width={281} height={166} densities={[1, 2]} loading="lazy" />
              </span>
            </div>

            <p class="placa__rotulo placa__rotulo--patrocinan">Patrocinan y acompañan</p>
          </div>
        </div>
      </article>
    </dialog>
  </section>

  {/* ------------------------------------------------------------ espacios */}
  <section class="seccion espacios" data-seccion>
    <div class="calle">
      <Nodo texto="El recorrido" recorrido="parque" />
      <h2 class="titulo revela">Espacio por espacio</h2>
      <p class="cuerpo revela espacios__bajada">
        Doce ambientes definidos en el anteproyecto, en el orden en que se recorren.
      </p>
    </div>

    {
      lista.map((e) => (
        <article class="espacio" data-seccion>
          <div class="calle espacio__par">
            <div class="espacio__texto">
              <Nodo texto={e.nodo} recorrido={e.recorrido} />
              <div class="revela-linea">
                <h3 class="subtitulo">{e.titulo}</h3>
                <p class="cuerpo espacio__cuerpo">{e.cuerpo}</p>
              </div>
            </div>

            {e.renders.length > 1 ? (
              <div class="espacio__carrusel revela">
                <Carrusel
                  renders={e.renders}
                  alt={e.alt}
                  titulo={e.titulo}
                  fig={e.fig}
                  ratio={e.ratio}
                  ancho="par"
                />
              </div>
            ) : (
              <figure class="espacio__lamina revela">
                <div class="marco-imagen" data-paralaje>
                  <Render
                    nombre={e.renders[0]}
                    alt={e.alt}
                    ratio={e.ratio}
                    sizes="(min-width: 62rem) min(46rem, 44vw), 100vw"
                  />
                </div>
                <figcaption class="epigrafe">
                  <span class="dato">Fig. {e.fig}</span>
                  <span>{e.titulo}</span>
                </figcaption>
              </figure>
            )}
          </div>
        </article>
      ))
    }
  </section>

  {/* ------------------------------------------------------------ propósito */}
  <section class="seccion proposito" data-seccion>
    <div class="calle">
      <Nodo texto="Propósito" recorrido="publico" />
      <blockquote class="proposito__cita revela">
        <p>{proposito.cita}</p>
        <cite class="rotulo proposito__fuente">Fundación Tassaroli</cite>
      </blockquote>

      <div class="proposito__texto revela-linea">
        <h2 class="titulo">{proposito.titulo}</h2>
        <p class="cuerpo bloque__cuerpo">{proposito.cuerpo}</p>
      </div>

      <div class="proposito__accion revela">
        <a class="accion" href="/documentacion">Ver la documentación <Flecha /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ------------------------------------------------------------ apertura */
  .apertura {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
  }

  .apertura__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .apertura__fondo :global(.apertura__render),
  .apertura__fondo :global(.lamina) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
  }

  .apertura__fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .apertura__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* El render entregado es claro (luminancia media 153/255), así que la
     rampa inferior sube antes y más fuerte que en la especificación: con los
     valores originales el antetítulo quedaba en 3.4:1, por debajo del mínimo
     AA. Con esta rampa llega a 5.4:1. */
  .apertura__velo--vertical {
    background: linear-gradient(
      180deg,
      rgba(20, 33, 61, 0.72) 0%,
      rgba(20, 33, 61, 0.3) 32%,
      rgba(20, 33, 61, 0.26) 52%,
      rgba(20, 33, 61, 0.6) 70%,
      rgba(20, 33, 61, 0.82) 86%,
      rgba(20, 33, 61, 0.92) 100%
    );
  }

  .apertura__velo--horizontal {
    background: linear-gradient(
      90deg,
      rgba(20, 33, 61, 0.62) 0%,
      rgba(20, 33, 61, 0.12) 48%,
      transparent 72%
    );
  }

  .apertura__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block-end: 3.5rem;
  }

  .apertura__ante {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    /* Un escalón más claro que el #9dc0ff de la especificación, para que a
       11px llegue a 5.4:1 sobre el render. */
    color: #b8d4ff;
  }

  .apertura__regla {
    flex: none;
    display: block;
    width: 36px;
    height: 1px;
    background: var(--azul-400);
  }

  /* "Proyecto Construcción" arriba, como renglón propio. En Montserrat para
     que forme una sola voz con el escudo que va debajo, y no en la tipografía
     del resto del sitio. */
  .apertura__previo {
    margin-block-start: clamp(0.9rem, 2vw, 1.35rem);
    font-family: 'Montserrat', var(--sans);
    font-size: clamp(1.1rem, 0.75rem + 1.5vw, 2rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.005em;
    color: rgba(255, 255, 255, 0.88);
  }

  /* El mismo escudo que abre el inicio, para que las dos aperturas digan lo
     mismo de la misma manera. Acá va al ras de la izquierda y no centrado:
     esta apertura apoya su texto abajo a la izquierda sobre el render, y
     centrarlo lo dejaría flotando en el medio de la foto. */
  .apertura__texto :global(.escudo) {
    justify-content: flex-start;
    margin-block-start: clamp(0.6rem, 1.4vw, 1rem);
  }

  .apertura__pie {
    display: flex;
    justify-content: flex-end;
    margin-block-start: 52px;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid rgba(255, 255, 255, 0.18);
  }

  .apertura__bajar {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    transition: color 180ms ease-out;
  }

  .apertura__bajar svg {
    rotate: 90deg;
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apertura__bajar:hover {
    color: #ffffff;
  }

  .apertura__bajar:hover svg {
    transform: translateX(4px);
  }

  .apertura :global(:focus-visible) {
    outline-color: var(--azul-400);
  }

  @media (max-width: 48rem) {
    .apertura__texto {
      padding-block-end: 2.5rem;
    }

    .apertura__pie {
      margin-block-start: 34px;
    }

    .apertura__velo--horizontal {
      background: linear-gradient(90deg, rgba(20, 33, 61, 0.6) 0%, rgba(20, 33, 61, 0.25) 100%);
    }
  }

  /* ---------------------------------------------------------- carta: tapa */

  /* Lo que queda en la página: numeral, título, marca y el botón que abre.
     Sin resumen ni extracto a propósito —un extracto de una carta obliga a
     leerla dos veces, la primera en falso. */
  .carta-tapa {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.1875rem);
    align-items: end;
  }

  @media (min-width: 56rem) {
    .carta-tapa {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .carta-tapa__accion {
      justify-content: flex-end;
    }
  }

  .carta-tapa__num {
    color: var(--acento);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .carta-tapa__titulo {
    margin-block-start: 0.875rem;
  }

  .carta-tapa__marca {
    margin-block-start: 0.875rem;
    color: var(--tinta-3);
  }

  .carta-tapa__accion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .carta-tapa__lectura {
    color: var(--tinta-3);
  }

  /* -------------------------------------------------------- carta: ventana */

  /* El <dialog> trae medidas y borde propios del navegador; se los sacamos
     para que sea la pantalla entera y el panel se centre adentro. */
  .carta-ventana {
    --panel-aire: clamp(1.5rem, 4vw, 3rem);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 24px;
    border: none;
    background: transparent;
    overscroll-behavior: contain;
  }

  .carta-ventana[open] {
    display: grid;
    place-items: center;
  }

  /* El velo va en color literal: las variables de :root no llegan a
     ::backdrop en todos los navegadores todavía. Es el --azul-900 del sitio
     al 58 %, como pide la pieza. */
  .carta-ventana::backdrop {
    background: rgba(20, 33, 61, 0.58);
    animation: carta-velo 300ms ease-out;
  }

  @keyframes carta-velo {
    from {
      opacity: 0;
    }
  }

  .carta-panel {
    display: flex;
    flex-direction: column;
    width: 820px;
    max-width: 100%;
    max-height: 100%;
    background: var(--papel);
    border-radius: 4px;
    box-shadow: 0 40px 90px -30px rgba(20, 33, 61, 0.65);
    overflow: hidden;
    animation: carta-panel 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes carta-panel {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta-ventana::backdrop,
    .carta-panel {
      animation: none;
    }
  }

  /* La cabecera no scrollea: dice dónde se está y cómo salir, y las dos cosas
     tienen que estar a mano en cualquier punto de la carta. */
  .carta-panel__cab {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 22px var(--panel-aire);
    border-block-end: 1px solid var(--linea);
    background: var(--papel);
  }

  .carta-panel__id {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-width: 0;
  }

  .carta-panel__num {
    color: var(--acento);
    letter-spacing: 0.08em;
  }

  .carta-panel__rotulo {
    color: var(--tinta-3);
  }

  .carta-panel__cerrar {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--linea-fuerte);
    font-family: var(--sans);
    font-stretch: 88%;
    font-weight: 620;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--tinta);
    cursor: pointer;
    transition: color 160ms ease-out, box-shadow 160ms ease-out;
  }

  .carta-panel__cerrar:hover {
    color: var(--acento);
    box-shadow: inset 0 0 0 1px var(--acento);
  }

  .carta-panel__cerrar span:last-child {
    font-size: 15px;
    line-height: 1;
  }

  .carta-panel__cuerpo {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.75rem, 4vw, 2.75rem) var(--panel-aire) 0;
  }

  /* --------------------------------------------------------------- carta */
  /* La cita abre la carta y tiene que leerse como una frase, no como una
     columna angosta apilada en seis renglones contra el margen izquierdo con
     media página vacía al lado.
     La medida va en `rem` y no en `ch` a propósito: `ch` se resuelve con el
     tamaño de fuente del elemento donde se declara —el del cuerpo, no el de
     la cita, que es el doble—, así que daba una caja mucho más angosta de lo
     que parecía. */
  .carta__epigrafe {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: min(60rem, 100%);
    border-inline-start: 2px solid var(--acento);
    padding-inline-start: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .carta__epigrafe p {
    font-size: clamp(1.25rem, 1rem + 1.9vw, 2.375rem);
    font-weight: 520;
    line-height: 1.25;
    letter-spacing: -0.024em;
    color: var(--tinta);
    text-wrap: pretty;
  }

  /* Una sola columna. En la página la carta iba en dos porque tenía el ancho
     entero; adentro del panel, que mide 820px menos márgenes, dos columnas
     dejarían renglones de cuarenta caracteres y se leería a los saltos. */
  .carta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .carta .cuerpo:first-child {
    font-size: clamp(1.125rem, 1.05rem + 0.55vw, 1.3125rem);
    color: var(--tinta);
  }


  /* La franja institucional cierra la carta, ahora dentro de la ventana. La
     ola y los logos viven en el último cuarto de una imagen de 2600x1726, y
     la imagen entra a ancho completo anclada abajo (`100% auto`, nunca
     `cover`, que estiraría y recortaría los logos por los costados). Lo que
     sobra por arriba es azul plano, continuado con `background-color` en el
     mismo color exacto para que la unión no se vea.

     Sale del margen del cuerpo con márgenes negativos: el texto respira a 48
     px del borde, la placa toca los bordes del panel. */
  .placa {
    position: relative;
    margin: clamp(2rem, 5vw, 2.75rem) calc(-1 * var(--panel-aire)) 0;
    min-block-size: 236px;
    background-color: #2869e8;
    background-image: var(--placa);
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% auto;
    color: #ffffff;
  }

  /* El logo de la Fundación vive acá, arriba a la izquierda y sobre el azul,
     en una tarjeta blanca como en la pieza del cliente. La placa quedó con el
     arco limpio en ese lugar: mientras estaba pintado dentro de la imagen,
     cualquier cambio de posición era cirugía sobre un mapa de bits. */
  .placa__impulsa {
    position: absolute;
    inset-block-start: 22px;
    inset-inline-start: var(--panel-aire);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .placa__tarjeta {
    display: block;
    padding: 14px 19px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 10px 26px -14px rgba(12, 30, 66, 0.5);
  }

  .placa__tarjeta :global(img) {
    display: block;
    width: 96px;
    height: auto;
  }

  .placa__rotulo {
    font-family: 'Montserrat', var(--sans);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .placa__rotulo--claro {
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.92);
  }

  /* El de los patrocinadores va sobre el blanco de la placa, y ahí sí depende
     de la geometría de la imagen: entra a ancho completo y anclada abajo, así
     que un punto de la imagen cae siempre a la misma fracción del ancho del
     panel. Las cifras salieron de dibujar la caja sobre la placa y mirar
     dónde caía, no de estimarla.

     Se oculta cuando el panel se achica: el hueco de blanco donde entra se
     encoge con él, y más abajo el rótulo caería encima de los logos. */
  .placa__rotulo--patrocinan {
    display: none;
  }

  @media (min-width: 56rem) {
    .placa__rotulo--patrocinan {
      display: block;
      position: absolute;
      inset-inline-start: 78.5%;
      inset-block-end: 88px;
      transform: translateX(-50%);
      font-size: 7px;
      color: #3f4a5c;
    }
  }

  /* La firma va sobre el papel y no sobre el azul. Quien lee la carta llega
     al nombre de quien la escribe antes de entrar en la placa institucional,
     que es de la Fundacion y no de ella. */
  .firma {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    padding-block-start: 1.35rem;
    border-block-start: 1px solid var(--linea-fuerte);
  }

  .firma__nombre {
    font-stretch: 102%;
    font-weight: 640;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }

  .firma__cargo {
    margin-block-start: 0.35rem;
    color: var(--tinta-3);
  }

  /* ------------------------------------------------------------ espacios */
  .espacios__bajada {
    margin-block-start: 0.85rem;
  }

  .espacio {
    padding-block-start: clamp(3rem, 7vw, 5.5rem);
  }

  .espacio__lamina {
    margin: 0;
  }

  .espacio__texto {
    padding-block-start: clamp(1.35rem, 3vw, 2rem);
  }

  .espacio__cuerpo {
    margin-block-start: 0.85rem;
  }

  .espacio__par {
    display: grid;
    gap: clamp(1.5rem, 3.5vw, 3rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .espacio__par {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      /* Tope de ancho, y no es una decisión estética.
         La imagen mide (contenido - hueco) / 2.05 * 1.05. Con el contenido
         topado en 92rem eso da 729px, y una pantalla retina pide el doble:
         1458px. Los renders del estudio miden 1537. O sea que acá, a
         cualquier tamaño de ventana, la imagen se achica o queda igual;
         nunca se agranda. Sin el tope, un monitor de 2560 pediría 2310px de
         una imagen de 1537 y se vería blanda. */
      max-width: calc(92rem + var(--rail) + 2 * var(--borde));
    }
  }

  /* ----------------------------------------------------------- propósito */
  .proposito {
    background: var(--azul-50);
    border-block-start: 1px solid var(--linea);
    margin-block-start: clamp(4rem, 9vw, 7rem);
  }

  /* En rem y no en ch: la unidad ch se mide contra el tamaño de letra del
     elemento donde se declara, y acá ese elemento es el blockquote, que
     hereda los 17px del cuerpo. Las "24ch" daban 204px y partían la frase
     en seis renglones de dos palabras. La frase entra en dos líneas, que es
     como se lee una afirmación de este tipo. */
  .proposito__cita {
    margin: 0 0 clamp(2rem, 4.5vw, 3.25rem);
    max-width: min(100%, 50rem);
  }

  .proposito__cita p {
    font-size: clamp(1.625rem, 1.1rem + 2.3vw, 3rem);
    font-weight: 650;
    font-stretch: 102%;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--acento-fuerte);
    text-wrap: balance;
  }

  .proposito__fuente {
    display: block;
    margin-block-start: 0.9rem;
    font-style: normal;
    color: var(--tinta-3);
  }

  .proposito__accion {
    margin-block-start: clamp(1.75rem, 3.5vw, 2.5rem);
  }
</style>

<script>
  const abre = document.querySelector<HTMLButtonElement>('[data-carta-abre]');
  const ventana = document.querySelector<HTMLDialogElement>('[data-carta-ventana]');

  if (abre && ventana) {
    const raiz = document.documentElement;

    /* Con la ventana abierta la página no se mueve detrás. El `<dialog>` ya
       deja inerte al resto, pero no frena la rueda, y ver el fondo correrse
       mientras se lee una carta es exactamente lo que rompe la ilusión de
       estar en otra parte.

       Al esconder la barra de scroll el documento se ensancha lo que ella
       medía y todo salta unos píxeles a la derecha. Por eso se compensa con
       el mismo ancho de relleno: la cuenta se hace antes de tapar nada. */
    let relleno = '';

    abre.addEventListener('click', () => {
      relleno = raiz.style.paddingInlineEnd;
      const barra = window.innerWidth - raiz.clientWidth;
      if (barra > 0) raiz.style.paddingInlineEnd = `${barra}px`;
      raiz.style.overflow = 'hidden';
      ventana.showModal();
    });

    // El foco vuelve al botón que abrió: quien cerró la carta estaba ahí.
    ventana.addEventListener('close', () => {
      raiz.style.overflow = '';
      raiz.style.paddingInlineEnd = relleno;
      abre.focus({ preventScroll: true });
    });

    /* Clic en el velo. El diálogo ocupa la pantalla entera y el panel está
       centrado adentro: si el clic cayó en el diálogo y no en el panel, cayó
       al costado. */
    ventana.addEventListener('click', (e) => {
      if (e.target === ventana) ventana.close();
    });
  }
</script>
