---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nodo from '../components/Nodo.astro';
import Flecha from '../components/Flecha.astro';
import isotipo from '../assets/marca-tassaroli.png';
import placa from '../assets/placa-fondo.webp';
import logoFundacion from '../assets/logos/fundacion.png';
import { sitio, carta, documentos, planos, acceso } from '../data/contenido';
import { COOKIE, cookieValida, enlaces } from '../lib/acceso';

export const prerender = false;
const autorizado = await cookieValida(Astro.cookies.get(COOKIE)?.value);
/* Los enlaces llegan de la variable de entorno, no del repositorio, que es
   público. Se leen igual para todos pero sólo se escriben en el HTML dentro
   de la rama autorizada: sin sesión, la página no los nombra ni una vez. */
const enlacesDrive = enlaces();
const sinEnlaces = Object.keys(enlacesDrive).length === 0;
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
const error = Astro.url.searchParams.get('error');
const mensajes: Record<string, string> = {
  clave: 'La contraseña no es correcta. Volvé a intentarlo.',
  config: 'El acceso no está disponible en este momento.',
  limite: 'Se alcanzó el límite de intentos. Probá de nuevo en 15 minutos.',
  origen: 'No se pudo validar la solicitud. Recargá la página.',
};
---

<Base
  titulo={`Documentación — ${sitio.fundacion}`}
  descripcion="Documentación integral del anteproyecto del Centro Tecnológico Carlos José Tassaroli."
  actual="/documentacion"
  heroOscuro={true}
>
  {/* ------------------------------------------------------------ apertura */}
  <section class="apertura sangrado" data-hero-oscuro>
    <div class="apertura__fondo">
      <Image
        class="apertura__filigrana"
        src={isotipo}
        alt=""
        width={900}
        height={900}
        densities={[1, 1.5]}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
      />
      <span class="apertura__velo"></span>
    </div>

    <div class="calle apertura__texto">
      <div class="apertura__fila">
        <i class="marca" style="--carril: 0" aria-hidden="true"></i>
        <h1 class="apertura__titulo">Documentación</h1>
      </div>
    </div>
  </section>

  {/* --------------------------------------------------------------- carta */}
  {/* En la página queda la tapa; la carta entera se lee en una ventana. El
      texto es el mismo, sólo cambió dónde se lee: en la página era la mancha
      más alta del sitio y el cliente pidió acortarla. */}
  <section class="seccion carta-seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Carta de la presidenta" recorrido="publico" />

      <div class="carta-tapa revela-linea">
        <div>
          <p class="dato carta-tapa__num">{carta.numero}</p>
          <h2 class="titulo carta-tapa__titulo">{carta.titulo}</h2>
          <p class="rotulo carta-tapa__marca">{sitio.fundacion}</p>
        </div>

        <div class="carta-tapa__accion">
          <button class="accion" type="button" data-carta-abre>
            {carta.abrir} <Flecha />
          </button>
          <span class="dato carta-tapa__lectura">{carta.lectura}</span>
        </div>
      </div>
    </div>

    {/* Un <dialog> nativo: la tecla Escape, el foco atrapado adentro y el
        resto de la página inerte los resuelve el navegador sin una línea
        nuestra. */}
    <dialog class="carta-ventana" data-carta-ventana aria-label={`${carta.titulo}, ${sitio.fundacion}`}>
      <article class="carta-panel">
        <header class="carta-panel__cab">
          <span class="carta-panel__id">
            <span class="dato carta-panel__num">{carta.numero}</span>
            <span class="rotulo carta-panel__rotulo">{carta.titulo} · {sitio.fundacion}</span>
          </span>

          <form method="dialog">
            <button class="carta-panel__cerrar" type="submit">
              <span>Cerrar</span>
              <span aria-hidden="true">×</span>
            </button>
          </form>
        </header>

        <div class="carta-panel__cuerpo">
          <blockquote class="carta__epigrafe">
            <p>{carta.epigrafe}</p>
          </blockquote>

          <div class="carta">
            {carta.parrafos.map((p) => <p class="cuerpo">{p}</p>)}
          </div>

          <div class="firma">
            <p class="firma__nombre">{carta.firma}</p>
            <p class="rotulo firma__cargo">{carta.cargo}</p>
          </div>

          {/* La placa institucional cierra la carta. Sale del margen del
              cuerpo para ocupar el ancho entero del panel, como en la pieza
              del cliente. */}
          <div class="placa" style={`--placa: url(${placa.src})`}>
            <div class="placa__impulsa">
              <p class="placa__rotulo placa__rotulo--claro">Desarrolla e impulsa</p>
              <span class="placa__tarjeta">
                <Image src={logoFundacion} alt="Fundación Tassaroli" width={281} height={166} densities={[1, 2]} loading="lazy" />
              </span>
            </div>

            <p class="placa__rotulo placa__rotulo--patrocinan">Patrocinan y acompañan</p>
          </div>
        </div>
      </article>
    </dialog>
  </section>

  <details class="documentacion-acceso" id="documentacion-acceso" data-documentacion open={autorizado || Boolean(error)}>
    <summary class="acceso">
      <span class="acceso__sello" aria-hidden="true">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </span>
      <span class="acceso__texto">
        <span class="rotulo acceso__etiqueta">Archivo del proyecto · Acceso privado</span>
        <span class="acceso__titulo">{acceso.titulo}</span>
        <span class="acceso__descripcion">Informes técnicos, memorias y planos del Centro Tecnológico.</span>
      </span>
      <span class="acceso__circulo" aria-hidden="true">
        <svg class="acceso__icono" width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.5" /></svg>
      </span>
    </summary>
    <div class="acceso__panel" data-documentacion-contenido>
    {!autorizado ? (
      <div class="acceso-formulario calle">
        <div class="acceso-formulario__intro">
          <span class="rotulo">Documentación reservada</span>
          <h2 class="subtitulo">El proyecto, en detalle.</h2>
          <p class="cuerpo">Ingresá la contraseña para consultar los documentos y acceder a cada archivo.</p>
        </div>
        <form class="acceso-formulario__form" action="/api/acceso" method="post" data-acceso-form>
          <label for="clave-documentacion">Contraseña de acceso</label>
          <div class="acceso-formulario__campo">
            <input id="clave-documentacion" name="clave" type="password" autocomplete="current-password" required maxlength="256" placeholder="Ingresá tu contraseña" aria-describedby="acceso-error" aria-invalid={error === 'clave' ? 'true' : undefined} />
            <button class="acceso-formulario__mostrar" type="button" aria-controls="clave-documentacion" aria-pressed="false" data-mostrar-clave>Mostrar</button>
          </div>
          <p class="acceso-formulario__error" id="acceso-error" role="alert">{error ? mensajes[error] ?? mensajes.origen : ''}</p>
          <button class="accion acceso-formulario__enviar" type="submit"><span data-enviar-texto>Ingresar a los archivos</span><Flecha /></button>
        </form>
      </div>
    ) : (
      <div data-archivos>
        <div class="calle acceso__sesion">
          <p class="cuerpo">
            {sinEnlaces
              ? 'El archivo no está disponible en este momento. Escribinos y lo resolvemos.'
              : 'Acceso habilitado. Seleccioná el documento que querés consultar.'}
          </p>
          <form method="post" action="/api/salir"><button class="acceso__salir" type="submit">Cerrar acceso</button></form>
        </div>
  {/* ------------------------------------------------------------- índice */}
  <section class="seccion" data-seccion>
    <div class="calle">
      <Nodo texto="Informes" recorrido="investigacion" />
      <h2 class="titulo">Documentación integral del proyecto</h2>

      <ol class="legajo">
        {
          documentos.map((d, i) => (
            <li class="legajo__fila">
              <span class="dato legajo__n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="legajo__lema">{d.lema}</p>
                <h3 class="legajo__titulo">
                  <a class="legajo__enlace" href={enlacesDrive[d.slug]} target="_blank" rel="noopener">
                    {d.titulo}
                  </a>
                </h3>
                <p class="legajo__bajada">{d.bajada}</p>
              </div>
              <div class="legajo__accion">
                <a class="descarga" href={enlacesDrive[d.slug]} target="_blank" rel="noopener" tabindex="-1">
                  <span class="rotulo">Abrir</span>
                  <span class="dato descarga__peso">PDF · Drive</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* -------------------------------------------------------------- planos */}
  <section class="seccion banda planos" data-seccion>
    <div class="calle">
      <Nodo texto="Anteproyecto" recorrido="investigacion" />
      <h2 class="titulo">{planos.titulo}</h2>
      <p class="cuerpo bloque__cuerpo">{planos.bajada}</p>

      <ul class="laminas">
        {planos.laminas.map((l) => <li class="lamina-fila">{l}</li>)}
      </ul>

      <div class="planos__accion">
        <a class="accion" href={enlacesDrive.planos} target="_blank" rel="noopener">
          Acceder a los planos <Flecha />
        </a>
      </div>
    </div>
  </section>
      </div>
    )}
    </div>
  </details>
</Base>

<style>
  /* ------------------------------------------------------------ apertura */
  .apertura {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 100svh;
    overflow: hidden;
    /* El mismo degradé de la placa, en CSS. Sirve de respaldo mientras el
       archivo no esté cargado y evita el destello blanco del primer frame.
       La definición vive en base.css: la comparte con el pie. */
    background: var(--placa-degrade);
  }

  .apertura__fondo {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Marca de agua del isotipo del Centro sobre el degradé. El archivo es
     azul y monocromo, así que se pasa a blanco con un filtro. */
  .apertura__filigrana {
    position: absolute;
    inset-inline-end: -6vw;
    inset-block-start: 50%;
    width: min(46rem, 58vw);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    translate: 0 -50%;
    opacity: 0.16;
    filter: brightness(0) invert(1);
    pointer-events: none;
  }

  /* Un solo velo, y sólo abajo: el lockup de la placa tiene que verse
     limpio en la mitad superior. */
  .apertura__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 58%,
      rgba(20, 33, 61, 0.22) 80%,
      rgba(20, 33, 61, 0.45) 100%
    );
  }

  .apertura__texto {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block-end: 3.5rem;
  }

  .apertura__fila {
    position: relative;
    padding-inline-start: var(--rail);
    margin-inline-start: calc(-1 * var(--rail));
  }

  .apertura__fila .marca {
    position: absolute;
    inset-block-start: 0.52em;
    margin-block-start: 0;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.25);
  }

  .apertura__titulo {
    color: #ffffff;
    font-size: clamp(2.25rem, 1.3rem + 3.2vw, 3.875rem);
    font-weight: 630;
    font-stretch: 104%;
    line-height: 1;
    letter-spacing: -0.034em;
  }

  @media (max-width: 48rem) {
    .apertura__filigrana {
      inset-inline-end: -22vw;
      width: min(30rem, 92vw);
      opacity: 0.13;
    }

    .apertura__texto {
      padding-block-end: 2.5rem;
    }
  }

  /* -------------------------------------------------------------- acceso */
  .documentacion-acceso {
    margin-block: 1rem clamp(3rem, 6vw, 6rem);
    scroll-margin-top: 7rem;
  }
  .acceso {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    margin-inline: calc(var(--rail) + var(--borde)) var(--borde);
    padding: clamp(1.5rem, 4vw, 3.5rem);
    color: white;
    background: linear-gradient(115deg, var(--azul-900), #163f78);
    border: 1px solid #315485;
    border-radius: 8px;
    cursor: pointer;
    list-style: none;
    box-shadow: 0 14px 36px -24px var(--azul-900);
    transition: box-shadow 300ms ease, border-color 300ms ease;
  }
  .acceso::before {
    content: '';
    position: absolute;
    z-index: -1;
    width: 28rem;
    height: 28rem;
    right: -10rem;
    top: -16rem;
    border: 1px solid #ffffff20;
    border-radius: 50%;
    box-shadow: 0 0 0 3rem #ffffff05, 0 0 0 6rem #ffffff05;
    transition: transform 650ms ease;
  }
  .acceso:hover::before { transform: translate(-2rem, 1rem); }
  .acceso:hover { border-color: #7096ca; box-shadow: 0 20px 40px -24px var(--azul-900); }
  .acceso::-webkit-details-marker { display: none; }
  .acceso:focus-visible { outline: 3px solid var(--acento); outline-offset: 5px; }
  .acceso__sello, .acceso__circulo { display: grid; place-items: center; flex-shrink: 0; }
  .acceso__sello { width: 4rem; height: 4rem; border: 1px solid #ffffff40; border-radius: 16px; background: #ffffff0a; }
  .acceso__texto { display: grid; gap: 0.75rem; flex: 1; min-width: 0; }
  .acceso__etiqueta { color: #c2d8f6; font-size: 0.6875rem; line-height: 1.6; }
  .acceso__titulo { font-size: clamp(1.5rem, 2.8vw, 2.5rem); font-weight: 560; line-height: 1.12; letter-spacing: -0.025em; }
  .acceso__descripcion { color: #d3e0f2; font-size: 0.9375rem; line-height: 1.5; }
  .acceso__circulo { width: 3rem; height: 3rem; border: 1px solid #ffffff60; border-radius: 50%; transition: background 200ms ease; }
  .acceso:hover .acceso__circulo { background: #ffffff18; }
  .acceso__icono { transition: transform 350ms ease; }
  .documentacion-acceso[open] .acceso__icono { transform: rotate(180deg); }
  .acceso__panel { overflow: hidden; }
  .acceso-formulario { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 7rem); padding-block: clamp(2rem, 4vw, 4rem); }
  .acceso-formulario__intro .rotulo { color: var(--acento); }
  .acceso-formulario__intro h2 { margin-block: 1rem; }
  .acceso-formulario__intro p { max-width: 43ch; }
  .acceso-formulario__form { width: 100%; max-width: 32rem; align-self: center; }
  .acceso-formulario__form label { display: block; margin-block-end: 0.7rem; font-weight: 600; font-size: 0.9375rem; }
  .acceso-formulario__campo { display: flex; border: 1px solid var(--linea-fuerte); border-radius: 4px; background: white; }
  .acceso-formulario__campo:focus-within { border-color: var(--acento); outline: 2px solid var(--azul-50); }
  .acceso-formulario__campo input { flex: 1; width: 0; min-width: 0; padding: 1rem; border: 0; background: transparent; font: inherit; font-size: 1rem; color: var(--tinta); }
  .acceso-formulario__mostrar { padding-inline: 1rem; min-height: 48px; background: transparent; border: 0; color: var(--acento); cursor: pointer; font: inherit; font-size: 0.8125rem; }
  .acceso-formulario__error { color: #a12626; font-size: 0.875rem; line-height: 1.5; margin-block: 0.65rem; }
  .acceso-formulario__error:empty { display: none; }
  .acceso-formulario__enviar { margin-block-start: 1rem; width: 100%; justify-content: space-between; }
  .acceso-formulario__enviar:disabled { opacity: 0.65; cursor: wait; }
  .acceso__sesion { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-block-start: 2rem; }
  .acceso__salir { color: var(--acento); background: transparent; border: 0; min-height: 44px; text-decoration: underline; text-underline-offset: 4px; font: inherit; cursor: pointer; }
  @media (max-width: 48rem) {
    .acceso { display: grid; grid-template-columns: 1fr auto; gap: 1.25rem; }
    .acceso__sello { width: 2.75rem; height: 2.75rem; border-radius: 10px; }
    .acceso__texto { grid-column: 1 / -1; grid-row: 2; }
    .acceso__circulo { grid-column: 2; grid-row: 1; width: 2.75rem; height: 2.75rem; }
    .acceso-formulario { grid-template-columns: 1fr; }
    .acceso-formulario__form { max-width: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .acceso, .acceso::before, .acceso__icono, .acceso__circulo { transition: none; }
  }

  /* -------------------------------------------------------------- índice */
  .legajo {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
    border-block-start: 2px solid var(--tinta);
  }

  .legajo__fila {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    padding-block: clamp(1.25rem, 2.6vw, 1.75rem);
    border-block-end: 1px solid var(--linea);
  }

  @media (min-width: 54rem) {
    .legajo__fila {
      grid-template-columns: 3rem minmax(0, 1fr) minmax(0, 10rem);
      align-items: start;
      gap: 1.5rem;
    }
  }

  .legajo__n {
    color: var(--tinta-3);
    padding-block-start: 0.3rem;
  }

  .legajo__lema {
    font-stretch: 82%;
    font-weight: 620;
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--acento);
  }

  .legajo__titulo {
    margin-block-start: 0.4rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.1875rem);
    font-weight: 620;
    letter-spacing: -0.016em;
    line-height: 1.26;
  }

  .legajo__enlace {
    color: var(--tinta);
    text-decoration: none;
    transition: color 160ms ease-out;
  }

  .legajo__enlace:hover {
    color: var(--acento);
  }

  /* El título es el enlace real; toda la fila responde al hover. */
  .legajo__fila:hover .legajo__enlace {
    color: var(--acento);
  }

  .legajo__bajada {
    margin-block-start: 0.55rem;
    max-width: 62ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--tinta-2);
    text-wrap: pretty;
  }

  .legajo__accion {
    grid-column: 2 / -1;
  }

  @media (min-width: 54rem) {
    .legajo__accion {
      grid-column: auto;
      justify-self: end;
      text-align: right;
    }
  }

  .descarga {
    display: inline-flex;
    flex-direction: column;
    gap: 0.28rem;
    padding: 0.55rem 0.8rem;
    text-decoration: none;
    color: var(--tinta);
    background: var(--papel);
    border: 1px solid var(--linea-fuerte);
    border-radius: 2px;
    transition: border-color 160ms ease-out, color 160ms ease-out, background-color 160ms ease-out;
  }

  .legajo__fila:hover .descarga {
    color: var(--acento);
    border-color: var(--acento);
    background: var(--azul-50);
  }

  .descarga__peso {
    color: var(--tinta-3);
  }

  /* -------------------------------------------------------------- planos */
  .laminas {
    list-style: none;
    padding: 0;
    margin: clamp(1.75rem, 3.5vw, 2.75rem) 0 0;
    border-block-start: 2px solid var(--tinta);
  }

  .lamina-fila {
    padding-block: 1.05rem;
    border-block-end: 1px solid var(--linea);
    font-weight: 560;
    color: var(--tinta);
  }

  .planos__accion {
    margin-block-start: clamp(1.75rem, 3.5vw, 2.5rem);
  }
  /* ---------------------------------------------------------- carta: tapa */

  /* Lo que queda en la página: numeral, título, marca y el botón que abre.
     Sin resumen ni extracto a propósito —un extracto de una carta obliga a
     leerla dos veces, la primera en falso. */
  .carta-tapa {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3.1875rem);
    align-items: end;
  }

  @media (min-width: 56rem) {
    .carta-tapa {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .carta-tapa__accion {
      justify-content: flex-end;
    }
  }

  .carta-tapa__num {
    color: var(--acento);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .carta-tapa__titulo {
    margin-block-start: 0.875rem;
  }

  .carta-tapa__marca {
    margin-block-start: 0.875rem;
    color: var(--tinta-3);
  }

  .carta-tapa__accion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .carta-tapa__lectura {
    color: var(--tinta-3);
  }

  /* -------------------------------------------------------- carta: ventana */

  /* El <dialog> trae medidas y borde propios del navegador; se los sacamos
     para que sea la pantalla entera y el panel se centre adentro. */
  .carta-ventana {
    --panel-aire: clamp(1.5rem, 4vw, 3rem);
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    padding: 24px;
    border: none;
    background: transparent;
    overscroll-behavior: contain;
  }

  .carta-ventana[open] {
    display: grid;
    place-items: center;
  }

  /* El velo va en color literal: las variables de :root no llegan a
     ::backdrop en todos los navegadores todavía. Es el --azul-900 del sitio
     al 58 %, como pide la pieza. */
  .carta-ventana::backdrop {
    background: rgba(20, 33, 61, 0.58);
    animation: carta-velo 300ms ease-out;
  }

  @keyframes carta-velo {
    from {
      opacity: 0;
    }
  }

  .carta-panel {
    display: flex;
    flex-direction: column;
    width: 820px;
    max-width: 100%;
    max-height: 100%;
    background: var(--papel);
    border-radius: 4px;
    box-shadow: 0 40px 90px -30px rgba(20, 33, 61, 0.65);
    overflow: hidden;
    animation: carta-panel 520ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes carta-panel {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta-ventana::backdrop,
    .carta-panel {
      animation: none;
    }
  }

  /* La cabecera no scrollea: dice dónde se está y cómo salir, y las dos cosas
     tienen que estar a mano en cualquier punto de la carta. */
  .carta-panel__cab {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 22px var(--panel-aire);
    border-block-end: 1px solid var(--linea);
    background: var(--papel);
  }

  .carta-panel__id {
    display: flex;
    align-items: baseline;
    gap: 14px;
    min-width: 0;
  }

  .carta-panel__num {
    color: var(--acento);
    letter-spacing: 0.08em;
  }

  .carta-panel__rotulo {
    color: var(--tinta-3);
  }

  .carta-panel__cerrar {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 2px;
    box-shadow: inset 0 0 0 1px var(--linea-fuerte);
    font-family: var(--sans);
    font-stretch: 88%;
    font-weight: 620;
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--tinta);
    cursor: pointer;
    transition: color 160ms ease-out, box-shadow 160ms ease-out;
  }

  .carta-panel__cerrar:hover {
    color: var(--acento);
    box-shadow: inset 0 0 0 1px var(--acento);
  }

  .carta-panel__cerrar span:last-child {
    font-size: 15px;
    line-height: 1;
  }

  .carta-panel__cuerpo {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.75rem, 4vw, 2.75rem) var(--panel-aire) 0;
  }

  /* --------------------------------------------------------------- carta */
  /* La cita abre la carta y tiene que leerse como una frase, no como una
     columna angosta apilada en seis renglones contra el margen izquierdo con
     media página vacía al lado.
     La medida va en `rem` y no en `ch` a propósito: `ch` se resuelve con el
     tamaño de fuente del elemento donde se declara —el del cuerpo, no el de
     la cita, que es el doble—, así que daba una caja mucho más angosta de lo
     que parecía. */
  .carta__epigrafe {
    margin: 0 0 clamp(1.75rem, 3.5vw, 2.75rem);
    max-width: min(60rem, 100%);
    border-inline-start: 2px solid var(--acento);
    padding-inline-start: clamp(1.1rem, 2.5vw, 1.75rem);
  }

  .carta__epigrafe p {
    font-size: clamp(1.25rem, 1rem + 1.9vw, 2.375rem);
    font-weight: 520;
    line-height: 1.25;
    letter-spacing: -0.024em;
    color: var(--tinta);
    text-wrap: pretty;
  }

  /* Una sola columna. En la página la carta iba en dos porque tenía el ancho
     entero; adentro del panel, que mide 820px menos márgenes, dos columnas
     dejarían renglones de cuarenta caracteres y se leería a los saltos. */
  .carta {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .carta .cuerpo:first-child {
    font-size: clamp(1.125rem, 1.05rem + 0.55vw, 1.3125rem);
    color: var(--tinta);
  }


  /* La franja institucional cierra la carta, ahora dentro de la ventana. La
     ola y los logos viven en el último cuarto de una imagen de 2600x1726, y
     la imagen entra a ancho completo anclada abajo (`100% auto`, nunca
     `cover`, que estiraría y recortaría los logos por los costados). Lo que
     sobra por arriba es azul plano, continuado con `background-color` en el
     mismo color exacto para que la unión no se vea.

     Sale del margen del cuerpo con márgenes negativos: el texto respira a 48
     px del borde, la placa toca los bordes del panel. */
  .placa {
    position: relative;
    margin: clamp(2rem, 5vw, 2.75rem) calc(-1 * var(--panel-aire)) 0;
    min-block-size: 236px;
    background-color: #2869e8;
    background-image: var(--placa);
    background-repeat: no-repeat;
    background-position: center bottom;
    background-size: 100% auto;
    color: #ffffff;
  }

  /* El logo de la Fundación vive acá, arriba a la izquierda y sobre el azul,
     en una tarjeta blanca como en la pieza del cliente. La placa quedó con el
     arco limpio en ese lugar: mientras estaba pintado dentro de la imagen,
     cualquier cambio de posición era cirugía sobre un mapa de bits. */
  .placa__impulsa {
    position: absolute;
    inset-block-start: 22px;
    inset-inline-start: var(--panel-aire);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .placa__tarjeta {
    display: block;
    padding: 14px 19px;
    background: #ffffff;
    border-radius: 14px;
    box-shadow: 0 10px 26px -14px rgba(12, 30, 66, 0.5);
  }

  .placa__tarjeta :global(img) {
    display: block;
    width: 96px;
    height: auto;
  }

  .placa__rotulo {
    font-family: 'Montserrat', var(--sans);
    font-weight: 500;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .placa__rotulo--claro {
    font-size: 9.5px;
    color: rgba(255, 255, 255, 0.92);
  }

  /* El de los patrocinadores va sobre el blanco de la placa, y ahí sí depende
     de la geometría de la imagen: entra a ancho completo y anclada abajo, así
     que un punto de la imagen cae siempre a la misma fracción del ancho del
     panel. Las cifras salieron de dibujar la caja sobre la placa y mirar
     dónde caía, no de estimarla.

     Se oculta cuando el panel se achica: el hueco de blanco donde entra se
     encoge con él, y más abajo el rótulo caería encima de los logos. */
  .placa__rotulo--patrocinan {
    display: none;
  }

  @media (min-width: 56rem) {
    .placa__rotulo--patrocinan {
      display: block;
      position: absolute;
      inset-inline-start: 78.5%;
      inset-block-end: 88px;
      transform: translateX(-50%);
      font-size: 7px;
      color: #3f4a5c;
    }
  }

  /* La firma va sobre el papel y no sobre el azul. Quien lee la carta llega
     al nombre de quien la escribe antes de entrar en la placa institucional,
     que es de la Fundacion y no de ella. */
  .firma {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    padding-block-start: 1.35rem;
    border-block-start: 1px solid var(--linea-fuerte);
  }

  .firma__nombre {
    font-stretch: 102%;
    font-weight: 640;
    font-size: 1.1875rem;
    letter-spacing: -0.02em;
    color: var(--tinta);
  }

  .firma__cargo {
    margin-block-start: 0.35rem;
    color: var(--tinta-3);
  }
</style>

<style is:global>
  /* Sobre la placa el recorrido va en blanco; a partir de la sección
     siguiente el degradé lo devuelve al azul de siempre. */
  :root {
    --red-alto: rgba(255, 255, 255, 0.55);
  }
</style>

<script>
  import gsap from 'gsap';

  const detalle = document.querySelector<HTMLDetailsElement>('[data-documentacion]');
  const resumen = detalle?.querySelector('summary');
  const panel = detalle?.querySelector<HTMLElement>('[data-documentacion-contenido]');
  const reduceMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');
  const actualizarRecorrido = () => window.dispatchEvent(new Event('resize'));
  let desplegado = Boolean(detalle?.open);

  if (detalle && resumen && panel) {
    resumen.addEventListener('click', (event) => {
      event.preventDefault();
      desplegado = !desplegado;
      gsap.killTweensOf(panel);
      if (reduceMovimiento.matches) {
        detalle.open = desplegado;
        gsap.set(panel, { clearProps: 'height,opacity,transform' });
        actualizarRecorrido();
        return;
      }
      if (desplegado) {
        const estabaAbierto = detalle.open;
        detalle.open = true;
        if (!estabaAbierto) gsap.set(panel, { height: 0, opacity: 0 });
        gsap.to(panel, {
          height: panel.scrollHeight, opacity: 1, duration: 0.5, ease: 'power3.out',
          onComplete: () => { gsap.set(panel, { clearProps: 'height,opacity' }); actualizarRecorrido(); },
        });
        gsap.fromTo(panel.querySelectorAll('.acceso-formulario__intro, .acceso-formulario__form'),
          { y: 14, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, stagger: 0.08, overwrite: true, clearProps: 'transform,opacity' });
      } else {
        gsap.to(panel, { height: 0, opacity: 0, duration: 0.3, ease: 'power2.inOut', onComplete: () => {
          detalle.open = false;
          gsap.set(panel, { clearProps: 'height,opacity' });
          actualizarRecorrido();
        } });
      }
    });

    detalle.addEventListener('click', (event) => {
      const boton = (event.target as Element).closest<HTMLButtonElement>('[data-mostrar-clave]');
      const campo = detalle.querySelector<HTMLInputElement>('#clave-documentacion');
      if (!boton || !campo) return;
      const mostrar = campo.type === 'password';
      campo.type = mostrar ? 'text' : 'password';
      boton.textContent = mostrar ? 'Ocultar' : 'Mostrar';
      boton.setAttribute('aria-pressed', String(mostrar));
    });

    detalle.addEventListener('submit', async (event) => {
      const form = event.target as HTMLFormElement;
      if (!form.matches('[data-acceso-form]')) return;
      event.preventDefault();
      const boton = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
      const texto = form.querySelector<HTMLElement>('[data-enviar-texto]')!;
      const error = form.querySelector<HTMLElement>('[role="alert"]')!;
      const campo = form.querySelector<HTMLInputElement>('[name="clave"]')!;
      if (boton.disabled) return;
      boton.disabled = true;
      texto.textContent = 'Validando acceso…';
      form.setAttribute('aria-busy', 'true');
      error.textContent = '';
      campo.removeAttribute('aria-invalid');
      try {
        const respuesta = await fetch(form.action, {
          method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' },
        });
        const resultado = await respuesta.json();
        if (!respuesta.ok || !resultado.ok) {
          const mensajes: Record<string, string> = {
            clave: 'La contraseña no es correcta. Volvé a intentarlo.',
            limite: 'Se alcanzó el límite de intentos. Probá de nuevo en 15 minutos.',
            config: 'El acceso no está disponible en este momento.',
          };
          error.textContent = mensajes[resultado.error] ?? 'No se pudo ingresar. Volvé a intentarlo.';
          if (resultado.error === 'clave') { campo.setAttribute('aria-invalid', 'true'); campo.focus(); campo.select(); }
          return;
        }
        const pagina = await fetch('/documentacion', { cache: 'no-store' });
        if (!pagina.ok) throw new Error('No se pudo cargar la documentación');
        const html = new DOMParser().parseFromString(await pagina.text(), 'text/html');
        const contenido = html.querySelector('[data-documentacion-contenido]');
        if (!contenido?.querySelector('[data-archivos]')) throw new Error('Sesión no disponible');
        gsap.killTweensOf(panel);
        gsap.set(panel, { clearProps: 'height,opacity' });
        panel.replaceChildren(...Array.from(contenido.childNodes));
        const titulo = panel.querySelector<HTMLElement>('h2');
        titulo?.setAttribute('tabindex', '-1');
        titulo?.focus({ preventScroll: true });
        if (!reduceMovimiento.matches) {
          gsap.fromTo(panel.querySelectorAll('.acceso__sesion, .legajo__fila'),
            { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, stagger: 0.04, clearProps: 'transform,opacity' });
        }
        actualizarRecorrido();
      } catch {
        error.textContent = 'No se pudo conectar. Revisá tu conexión y volvé a intentarlo.';
      } finally {
        boton.disabled = false;
        texto.textContent = 'Ingresar a los archivos';
        form.removeAttribute('aria-busy');
      }
    });
  }

  const abre = document.querySelector<HTMLButtonElement>('[data-carta-abre]');
  const ventana = document.querySelector<HTMLDialogElement>('[data-carta-ventana]');

  if (abre && ventana) {
    const raiz = document.documentElement;

    /* Con la ventana abierta la página no se mueve detrás. El `<dialog>` ya
       deja inerte al resto, pero no frena la rueda, y ver el fondo correrse
       mientras se lee una carta es exactamente lo que rompe la ilusión de
       estar en otra parte.

       Al esconder la barra de scroll el documento se ensancha lo que ella
       medía y todo salta unos píxeles a la derecha. Por eso se compensa con
       el mismo ancho de relleno: la cuenta se hace antes de tapar nada. */
    let relleno = '';

    abre.addEventListener('click', () => {
      relleno = raiz.style.paddingInlineEnd;
      const barra = window.innerWidth - raiz.clientWidth;
      if (barra > 0) raiz.style.paddingInlineEnd = `${barra}px`;
      raiz.style.overflow = 'hidden';
      ventana.showModal();
    });

    // El foco vuelve al botón que abrió: quien cerró la carta estaba ahí.
    ventana.addEventListener('close', () => {
      raiz.style.overflow = '';
      raiz.style.paddingInlineEnd = relleno;
      abre.focus({ preventScroll: true });
    });

    /* Clic en el velo. El diálogo ocupa la pantalla entera y el panel está
       centrado adentro: si el clic cayó en el diálogo y no en el panel, cayó
       al costado. */
    ventana.addEventListener('click', (e) => {
      if (e.target === ventana) ventana.close();
    });
  }
</script>
