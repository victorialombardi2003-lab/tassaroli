---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Un render del anteproyecto.
 *
 * Los archivos viven en `src/assets/renders/` para que Astro los optimice:
 * genera WebP en varios anchos y arma el `srcset`. Se buscan por nombre, así
 * que sumar un render es dejar el archivo con el nombre que corresponde —
 * sin tocar código.
 *
 * Mientras un render no exista, dibuja una trama de rayado técnico con el
 * nombre del archivo que falta: una lámina sin imprimir, en el mismo
 * lenguaje que el resto del sitio.
 */

interface Props {
  nombre: string;
  alt: string;
  ratio?: string;
  prioridad?: boolean;
  clase?: string;
  sizes?: string;
}

const { nombre, alt, ratio = '16 / 9', prioridad = false, clase = '', sizes = '100vw' } = Astro.props;

const modulos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/renders/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);

const catalogo = new Map<string, ImageMetadata>();
for (const [ruta, modulo] of Object.entries(modulos)) {
  const base = ruta.split('/').pop()!.replace(/\.[^.]+$/, '');
  catalogo.set(base, modulo.default);
}

const imagen = catalogo.get(nombre);

/**
 * Los anchos del `srcset` se cortan en el ancho real del archivo. Pedir más
 * que eso no agrega detalle: agranda, y un render agrandado se ve blando.
 * El último escalón es siempre la medida nativa, para que en una pantalla
 * retina se entregue todo lo que la imagen tiene.
 */
const escalones = [480, 640, 960, 1280, 1600, 2000, 2400, 3200];
const anchos = imagen
  ? [...escalones.filter((a) => a < imagen.width), imagen.width]
  : undefined;
---

{
  imagen ? (
    <div class={`render ${clase}`} style={`aspect-ratio: ${ratio}`}>
      <Image
        src={imagen}
        alt={alt}
        widths={anchos}
        sizes={sizes}
        quality={90}
        loading={prioridad ? 'eager' : 'lazy'}
        decoding={prioridad ? 'sync' : 'async'}
      />
    </div>
  ) : (
    <div
      class={`lamina ${clase}`}
      style={`aspect-ratio: ${ratio}`}
      role="img"
      aria-label={`${alt} (render pendiente)`}
    >
      <svg class="lamina__trama" aria-hidden="true" focusable="false">
        <defs>
          <pattern
            id={`rayado-${nombre}`}
            width="13"
            height="13"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(45)"
          >
            <line x1="0" y1="0" x2="0" y2="13" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#rayado-${nombre})`} />
      </svg>
      <div class="lamina__rotulo">
        <span class="rotulo">Render pendiente</span>
        <span class="dato">{nombre}</span>
      </div>
    </div>
  )
}

<style>
  .render {
    width: 100%;
    background: var(--papel-4);
    overflow: hidden;
  }

  .render :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lamina {
    position: relative;
    width: 100%;
    display: grid;
    place-items: center;
    background: var(--papel-3);
    color: var(--linea-fuerte);
    overflow: hidden;
  }

  .lamina__trama {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lamina__rotulo {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.8rem 1.25rem;
    background: var(--papel);
    box-shadow: inset 0 0 0 1px var(--linea);
    color: var(--tinta-3);
    text-align: center;
    border-radius: 2px;
  }
</style>
