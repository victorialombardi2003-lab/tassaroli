---
import { Image } from 'astro:assets';
import isotipo from '../assets/isotipo-fundacion.png';

/**
 * La marca de la Fundación.
 *
 * El archivo del cliente es sólo el isotipo —el infinito formado por dos
 * figuras—, así que el nombre va escrito al lado, en Archivo con un peso
 * liviano y caja de oración: es lo más parecido al logotipo original que se
 * puede armar con la tipografía del sitio, sin cargar una fuente extra.
 *
 * El isotipo trae dos azules, uno claro y uno noche. Sobre el hero oscuro
 * se aplana a blanco con un filtro, y aunque los dos tonos se fundan la
 * forma se sigue leyendo: son los huecos transparentes, y no el contraste
 * entre los azules, los que dibujan el lazo.
 *
 * El nombre hereda el color del contenedor (`currentColor`), para que pase
 * a blanco junto con el signo.
 */
---

<span class="marca-lockup">
  <Image
    class="marca-lockup__signo"
    src={isotipo}
    alt=""
    width={120}
    height={71}
    densities={[1, 2]}
    loading="eager"
  />
  <span class="marca-lockup__nombre"
    >Fundación <span class="marca-lockup__apellido">Tassaroli</span></span
  >
</span>

<style>
  .marca-lockup {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .marca-lockup__signo {
    flex: none;
    width: auto;
    height: clamp(1.5rem, 3.2vw, 1.95rem);
    object-fit: contain;
  }

  /* El apellido va más pesado que "Fundación", como en el logotipo del
     cliente, donde TASSAROLI está en negrita y FUNDACIÓN no. */
  .marca-lockup__apellido {
    font-weight: 640;
  }

  .marca-lockup__nombre {
    font-family: var(--sans);
    font-size: clamp(0.9375rem, 2.1vw, 1.1875rem);
    font-weight: 430;
    font-stretch: 100%;
    letter-spacing: 0.002em;
    line-height: 1;
    white-space: nowrap;
    color: currentColor;
  }

  @media (max-width: 22rem) {
    .marca-lockup {
      gap: 0.45rem;
    }

    .marca-lockup__nombre {
      font-size: 0.875rem;
    }
  }
</style>
