---
import { Image } from 'astro:assets';
import isotipoCentro from '../assets/marca-tassaroli.png';

import '@fontsource-variable/archivo/standard.css';
import '@fontsource/martian-mono/400.css';
import '@fontsource/martian-mono/600.css';
import '../styles/base.css';

import Linea from '../components/Linea.astro';
import Marca from '../components/Marca.astro';
import Carga from '../components/Carga.astro';
import { sitio, navegacion } from '../data/contenido';

interface Props {
  titulo: string;
  descripcion?: string;
  actual: string;
  /** La página abre con un hero oscuro: la barra arranca en versión clara. */
  heroOscuro?: boolean;
}

const { titulo, descripcion = sitio.descripcion, actual, heroOscuro = false } = Astro.props;
const anio = new Date().getFullYear();
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://fundaciontassaroli.org.ar')} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={sitio.fundacion} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <script is:inline>
      // Tiene que correr antes del primer pintado, y por eso va acá adentro
      // y sin diferir. El atributo `data-motion` activa el estado previo de
      // las animaciones —las láminas arrancan tapadas—: si lo pusiera el
      // script de la página, que es un módulo y corre después de pintar, se
      // vería un instante la lámina entera, después taparse, y recién ahí el
      // barrido. Ese parpadeo es lo que esto evita.
      document.documentElement.dataset.motion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
        ? 'off'
        : 'on';
    </script>

    <noscript>
      <style>
        /* Salida 3: sin JavaScript la pantalla de carga no llega a
           mostrarse, porque no habría nada que la retire. */
        .carga { display: none !important; }
      </style>
    </noscript>
  </head>

  <body>
    <!--
      THESIS: El sitio se recorre como se recorrerá el edificio: una línea
      continua lo atraviesa y planta un nodo en cada destino. Rechaza el
      default del rubro: render a sangre con titular centrado sobre velo
      oscuro, tres tarjetas con ícono y franja de cifras contadoras.
      OWN-WORLD: Papel blanco con claros virados al azul; escala de azul en
      siete tonos como único acento; Archivo variable con eje de ancho para
      título y rótulos; Martian Mono sólo en medidas reales.
      STORY: El visitante ve un edificio documentado, sitiado y en parte ya
      construido; concluye que la Fundación cumple; pide la documentación.
      FIRST VIEWPORT: Título grande sobre papel, bajada, dos acciones, y el
      render a sangre debajo con paralaje. La línea entra por la calle
      izquierda y planta su primer nodo en la acción principal.
      FORM: Red de Recorridos, candidata 7 de 7, seed ba6bd9b2. Paleta
      redefinida por pedido del cliente: base clara, acentos azules.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, and DESIGN.md
    -->
    <Carga />

    <a class="saltar" href="#contenido">Ir al contenido</a>

    <header class="encabezado" data-encabezado data-sobre-oscuro={heroOscuro ? '' : undefined}>
      <div class="encabezado__interior">
        <a class="encabezado__marca" href="/" aria-label={`${sitio.fundacion} — inicio`}>
          <Marca />
        </a>

        <nav class="encabezado__nav" aria-label="Principal">
          {
            navegacion.map((item) => (
              <a
                class="encabezado__enlace rotulo"
                href={item.href}
                aria-current={actual === item.href ? 'page' : undefined}
              >
                {item.texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <div class="pagina" data-pagina>
      <Linea />
      <main id="contenido">
        <slot />
      </main>

      <footer class="pie">
        <Image
          class="pie__filigrana"
          src={isotipoCentro}
          alt=""
          width={760}
          height={760}
          densities={[1, 1.5]}
          loading="lazy"
          aria-hidden="true"
        />

        <div class="calle pie__interior">
          <div class="pie__identidad">
            <p class="pie__nombre">{sitio.fundacion}</p>
            <p class="dato pie__proyecto">{sitio.proyecto}</p>
            <p class="dato pie__lugar">{sitio.lugar}</p>
          </div>

          <nav class="pie__nav" aria-label="Pie de página">
            {
              navegacion.map((item) => (
                <a class="rotulo" href={item.href}>
                  {item.texto}
                </a>
              ))
            }
          </nav>

          <p class="dato pie__legal">© {anio} {sitio.fundacion}</p>
        </div>
      </footer>
    </div>

    <span class="centinela" data-centinela aria-hidden="true"></span>

    <style>
      /* --- encabezado --- */
      .encabezado {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--papel) 86%, transparent);
        backdrop-filter: blur(12px) saturate(1.4);
        border-block-end: 1px solid transparent;
        transition: border-color 260ms ease-out, box-shadow 260ms ease-out;
      }

      /* El desenfoque obliga a re-muestrear y difuminar todo lo que pasa por
         detrás, en cada cuadro de scroll. El encabezado es fijo, así que eso
         pasa siempre, y en un teléfono es de lo más caro que se puede pedir.
         Abajo de 48rem se cambia por un fondo casi opaco: se ve prácticamente
         igual y no cuesta nada. El estado sobre hero oscuro no se toca —tiene
         más especificidad y ya viene sin desenfoque. */
      @media (max-width: 47.99rem) {
        .encabezado {
          /* Opaco, no 97%: sin desenfoque detrás esa transparencia no aporta
             nada y deja pasar un fantasma del texto que va debajo. */
          background: var(--papel);
          backdrop-filter: none;
        }
      }

      /* Marca a la izquierda y navegación centrada. La tercera columna queda
         vacía a propósito: sin ella el centro se correría hacia la derecha. */
      .encabezado__interior {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 2.5rem;
        max-width: var(--max);
        margin-inline: auto;
        padding: 1.125rem var(--borde);
      }

      .encabezado__marca {
        display: block;
        color: var(--azul-marca);
        text-decoration: none;
        transition: color 260ms ease-out;
      }

      .encabezado__nav {
        display: flex;
        justify-content: center;
        gap: 2.75rem;
      }

      .encabezado__enlace {
        color: var(--tinta-3);
        text-decoration: none;
        white-space: nowrap;
        padding-block-end: 0.25rem;
        border-block-end: 2px solid transparent;
        transition: color 200ms ease-out, border-color 280ms cubic-bezier(0.16, 1, 0.3, 1);
      }

      .encabezado__enlace:hover {
        color: var(--tinta);
        border-block-end-color: var(--linea-fuerte);
      }

      .encabezado__enlace[aria-current='page'] {
        color: var(--acento-fuerte);
        border-block-end-color: var(--acento);
      }

      .encabezado.apoyado {
        border-block-end-color: var(--linea);
        box-shadow: 0 8px 24px -20px rgba(16, 59, 86, 0.45);
      }

      /* Versión clara: mientras la barra está sobre un hero oscuro y todavía
         no se apoyó. El logo es monocromo, así que se invierte a blanco con
         un filtro en vez de cargar un segundo archivo. */
      .encabezado[data-sobre-oscuro]:not(.apoyado) {
        background: transparent;
        backdrop-filter: none;
        border-block-end-color: rgba(255, 255, 255, 0.24);
      }

      .encabezado[data-sobre-oscuro]:not(.apoyado) .encabezado__marca {
        color: #ffffff;
      }

      .encabezado[data-sobre-oscuro]:not(.apoyado) .encabezado__marca :global(img) {
        filter: brightness(0) invert(1);
      }

      .encabezado[data-sobre-oscuro]:not(.apoyado) .encabezado__enlace {
        color: rgba(255, 255, 255, 0.8);
      }

      .encabezado[data-sobre-oscuro]:not(.apoyado) .encabezado__enlace:hover {
        color: #ffffff;
        border-block-end-color: rgba(255, 255, 255, 0.45);
      }

      /* Blanco, no azul: sobre una foto o sobre la placa naranja el azul
         pierde legibilidad. Vale para los dos heroes oscuros. */
      .encabezado[data-sobre-oscuro]:not(.apoyado) .encabezado__enlace[aria-current='page'] {
        color: #ffffff;
        border-block-end-color: #ffffff;
      }

      /* En pantallas chicas la grilla colapsa a dos filas: marca arriba,
         navegación abajo y alineada a la izquierda. */
      @media (max-width: 44rem) {
        .encabezado__interior {
          grid-template-columns: 1fr;
          gap: 0.5rem;
          padding-block: 0.75rem;
        }

        .encabezado__nav {
          justify-content: flex-start;
          gap: 1.25rem;
        }

        .encabezado__enlace {
          font-size: 0.6875rem;
          letter-spacing: 0.1em;
        }
      }

      @media (max-width: 22rem) {
        .encabezado__nav {
          gap: 0.9rem;
        }

        .encabezado__enlace {
          font-size: 0.625rem;
          letter-spacing: 0.06em;
        }
      }

      /* --- pie --- */
      /* El pie lleva el degradé de la placa institucional, el mismo que abre
         Documentación: cierra la página con la imagen de marca del cliente.

         Encima va un velo de azul noche al 62%, y no es decorativo. Sobre el
         naranja pleno el texto del pie da 1,9:1 y es ilegible; con el velo
         sube a 6,2:1, y sobre el azul del otro extremo a 9,0:1. El naranja
         queda como una brasa en la esquina en vez de una franja encendida,
         que además es lo que corresponde: un pie no grita. */
      .pie {
        position: relative;
        isolation: isolate;
        z-index: 1;
        background: var(--placa-degrade);
        background-color: var(--azul-900);
        color: #dfe4ee;
        padding-block: clamp(3rem, 7vw, 5rem);
      }

      .pie::before {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: color-mix(in srgb, var(--azul-900) 62%, transparent);
      }

      /* El isotipo del Centro como marca de agua. Va detrás del velo —z-index
         -2 contra -1— y no delante: así el mismo velo que hace legible al
         texto lo apaga a él también, y no hay forma de que compita.

         El archivo es azul y monocromo; se pasa a blanco con el filtro, igual
         que en la apertura de Documentación. El desenfoque es lo que lo vuelve
         atmósfera en vez de un logo apoyado en la esquina. */
      .pie__filigrana {
        position: absolute;
        inset-block-end: -14%;
        inset-inline-end: -4%;
        z-index: -2;
        width: min(30rem, 46vw);
        height: auto;
        aspect-ratio: 1;
        object-fit: contain;
        opacity: 0.3;
        filter: brightness(0) invert(1) blur(2px);
        pointer-events: none;
      }

      @media (max-width: 48rem) {
        .pie__filigrana {
          inset-inline-end: -18%;
          width: 62vw;
          opacity: 0.22;
        }
      }

      .pie__interior {
        display: grid;
        gap: clamp(2rem, 5vw, 3.5rem);
        grid-template-columns: 1fr;
      }

      @media (min-width: 48rem) {
        .pie__interior {
          grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
          align-items: start;
        }

        .pie__legal {
          grid-column: 1 / -1;
        }
      }

      .pie__nombre {
        font-stretch: 104%;
        font-weight: 640;
        font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.625rem);
        letter-spacing: -0.024em;
        color: #ffffff;
      }

      .pie__proyecto,
      .pie__lugar {
        color: #a9b4c8;
        margin-block-start: 0.5rem;
      }

      .pie__nav {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        align-items: start;
      }

      .pie__nav a {
        color: #dfe4ee;
        text-decoration: none;
        transition: color 180ms ease-out;
      }

      .pie__nav a:hover {
        color: var(--azul-400);
      }

      .pie :focus-visible {
        outline-color: var(--azul-400);
      }

      .pie__legal {
        color: #a9b4c8;
        padding-block-start: 1.5rem;
        border-block-start: 1px solid rgba(255, 255, 255, 0.14);
      }

      .centinela {
        position: absolute;
        inset-block-start: 88svh;
        inset-inline-start: 0;
        width: 1px;
        height: 1px;
      }
    </style>

    <script>
      const centinela = document.querySelector('[data-centinela]');
      const encabezado = document.querySelector('[data-encabezado]');
      if (centinela && encabezado) {
        new IntersectionObserver(([entrada]) =>
          encabezado.classList.toggle('apoyado', !entrada.isIntersecting),
        ).observe(centinela);
      }
    </script>
  </body>
</html>
