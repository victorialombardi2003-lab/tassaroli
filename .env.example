# Contraseña que se pide en /documentacion. La entrega la Fundación a quien
# la solicite. Una frase de cuatro palabras es más segura que ocho signos
# raros, y se puede dictar por teléfono.
ACCESO_PASSWORD=

# Secreto con el que se firma la cookie de sesión. No es la contraseña: si
# alguien lo conociera podría fabricarse una sesión sin saberla. Cadena larga
# y al azar, distinta de ACCESO_PASSWORD.
ACCESO_SECRET=

# Cuántas horas dura la sesión antes de volver a pedir la contraseña.
ACCESO_HORAS=12

# Los enlaces de Drive, en un JSON de una sola línea. Van acá y no en el
# repositorio porque el repositorio es público y los PDF ya no llevan
# contraseña propia: el enlace es el documento.
# Las claves son los `slug` de `documentos` en src/data/contenido.ts, más
# `planos` para la carpeta del anteproyecto.
# ACCESO_ENLACES={"memoria-tecnica":"https://drive.google.com/file/d/…/view","planos":"https://drive.google.com/drive/folders/…"}
ACCESO_ENLACES=
